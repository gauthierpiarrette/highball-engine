ntdll: Resolve GLOBALROOT aliases before DOS file path translation.

An application can prefix a mapped image's NT name with \\.\GLOBALROOT
and reopen it. The Unix path translator treated GLOBALROOT as a DOS device,
so \??\GLOBALROOT\??\C:\... failed despite the underlying file existing.
Walk root aliases only when they lead back into a DOS namespace; preserve
native-object lookup for other paths. Match whole components, case
insensitively, and support nested aliases without recursion.

Regression: tests/x64-fidelity/globalroot.c (normal/alias opens, attributes,
nested and mixed-case aliases, a mapped image name, and negative paths).

--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3363,16 +3363,31 @@
 static inline int get_dos_prefix_len( const UNICODE_STRING *name )
 {
     static const WCHAR dosdev_prefixW[] = {'\\','D','o','s','D','e','v','i','c','e','s','\\'};
-
-    if (name->Length >= sizeof(nt_prefixW) &&
-        !memcmp( name->Buffer, nt_prefixW, sizeof(nt_prefixW) ))
-        return ARRAY_SIZE( nt_prefixW );
-
-    if (name->Length >= sizeof(dosdev_prefixW) &&
-        !wcsnicmp( name->Buffer, dosdev_prefixW, ARRAY_SIZE( dosdev_prefixW )))
-        return ARRAY_SIZE( dosdev_prefixW );
-
-    return 0;
+    static const WCHAR globalrootW[] = {'G','L','O','B','A','L','R','O','O','T','\\'};
+    const WCHAR *ptr = name->Buffer;
+    unsigned int len = name->Length / sizeof(WCHAR), offset = 0, prefix_len;
+
+    for (;;)
+    {
+        if (len >= ARRAY_SIZE(nt_prefixW) && !memcmp( ptr, nt_prefixW, sizeof(nt_prefixW) ))
+            prefix_len = ARRAY_SIZE(nt_prefixW);
+        else if (len >= ARRAY_SIZE(dosdev_prefixW) &&
+                 !wcsnicmp( ptr, dosdev_prefixW, ARRAY_SIZE(dosdev_prefixW) ))
+            prefix_len = ARRAY_SIZE(dosdev_prefixW);
+        else
+            return 0;
+
+        /* GLOBALROOT names the object namespace root. Resolve another DOS prefix
+         * after it, leaving other native object paths to the server as before. */
+        if (len < prefix_len + ARRAY_SIZE(globalrootW) ||
+            wcsnicmp( ptr + prefix_len, globalrootW, ARRAY_SIZE(globalrootW) ))
+            return offset + prefix_len;
+
+        prefix_len += ARRAY_SIZE(globalrootW) - 1;  /* retain the root backslash */
+        ptr += prefix_len;
+        len -= prefix_len;
+        offset += prefix_len;
+    }
 }
 
 

index ca6dd4a..433a643 100644
--- a/dlls/ntdll/sync.c
+++ b/dlls/ntdll/sync.c
@@ -833,6 +833,7 @@ struct futex_queue
 {
     struct list queue;
     LONG lock;
+    LONG waiters; /* Highball: threads in RtlWaitOnAddress on this bucket; wakes skip the lock when 0 */
 };
 
 static struct futex_queue futex_queues[256];
@@ -846,8 +847,22 @@ static struct futex_queue *get_futex_queue( const void *addr )
 
 static void spin_lock( LONG *lock )
 {
+    unsigned int spins = 0;
+
+    /* Highball: test before test-and-set, and give the core away after a while: a holder that was preempted
+     * otherwise keeps every other thread spinning for its whole time slice. */
     while (InterlockedCompareExchange( lock, -1, 0 ))
-        YieldProcessor();
+    {
+        do
+        {
+            if (++spins >= 256)
+            {
+                NtYieldExecution();
+                spins = 0;
+            }
+            else YieldProcessor();
+        } while (ReadNoFence( lock ));
+    }

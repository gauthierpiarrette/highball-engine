 DEFINE_SYSCALL(NtYieldExecution, (void))
 
+/* Highball: a system call fills a buffer the program gave it from the Unix side. The emulator keeps a
+ * read-write-execute page that holds translated code read-execute, to see writes into that code: a write by the
+ * program faults into the emulator, which lets it through, but a write by the Unix side has no one to do that and
+ * the call fails with STATUS_ACCESS_VIOLATION, which Windows never returns for a buffer the program can write.
+ * Copy protections keep such buffers beside their own code. When a query fails that way and every page of the
+ * buffer is writable for the program (GuestProtection), touch each page from here, so that the emulator takes
+ * its trap away the way it does for the program's own writes, and say that the query can run again. A buffer the
+ * program really cannot write keeps its status, and no exception is raised for it. */
+static BOOL untrap_guest_buffer( void *ptr, SIZE_T size )
+{
+    ULONG_PTR page, start = (ULONG_PTR)ptr, end = start + size;
+    BOOL trapped = FALSE;
+
+    if (!ptr || !size || end < start || size > 0x1000000) return FALSE;
+    for (page = start & ~(ULONG_PTR)0xfff; page < end; page += 0x1000)
+    {
+        MEMORY_BASIC_INFORMATION info;
+        ULONG guest;
+
+        if (syscall_NtQueryVirtualMemory( GetCurrentProcess(), (void *)page, MemoryBasicInformation,
+                                          &info, sizeof(info), NULL )) return FALSE;
+        if (info.State != MEM_COMMIT) return FALSE;
+        guest = pGuestProtection( (void *)page, info.Protect );
+        if (guest != PAGE_READWRITE && guest != PAGE_EXECUTE_READWRITE)
+        {
+            WARN( "buffer %p-%p: page %p has protection %lx (%lx for the program), not retrying\n",
+                  (void *)start, (void *)end, (void *)page, info.Protect, guest );
+            return FALSE;
+        }
+        if (guest != info.Protect) trapped = TRUE;
+    }
+    if (!trapped) return FALSE;
+    for (page = start & ~(ULONG_PTR)0xfff; page < end; page += 0x1000)
+    {
+        volatile char *p = (volatile char *)(page < start ? start : page);
+        __atomic_fetch_or( p, 0, __ATOMIC_SEQ_CST );  /* writes back what is there */
+    }
+    return TRUE;
+}
+
+static BOOL retry_trapped_query( NTSTATUS status, const char *name, void *buffer, SIZE_T size,
+                                 void *ret_len, SIZE_T ret_size )
+{
+    BOOL ret;
+
+    if (status != STATUS_ACCESS_VIOLATION || !pGuestProtection) return FALSE;
+    if (get_arm64ec_cpu_area()->InSyscallCallback) return FALSE;
+    ret = untrap_guest_buffer( buffer, size );
+    if (untrap_guest_buffer( ret_len, ret_size )) ret = TRUE;
+    if (ret) WARN( "%s: buffer %p size %Ix was behind the emulator's write trap, running the query again\n",
+                   name, buffer, size );
+    return ret;
+}
+

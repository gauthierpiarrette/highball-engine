+    if (!pGuestProtection || (prot & writable)) return;
+    /* each page: only those the program itself made writable */
+    for (; page < end; page += 0x1000)
+    {
+        if (!(pGuestProtection( page, prot ) & writable)) continue;
+        if (count && (char *)ranges[count - 1].VirtualAddress + ranges[count - 1].NumberOfBytes == page)
+        {
+            ranges[count - 1].NumberOfBytes += 0x1000;
+            continue;
+        }
+        if (count == ARRAY_SIZE(ranges))
+        {
+            NtSetInformationVirtualMemory( GetCurrentProcess(), (VIRTUAL_MEMORY_INFORMATION_CLASS)HB_VM_EMULATOR_TRAP_INFORMATION,
+                                           count, ranges, &trap, sizeof(trap) );
+            count = 0;
+        }
+        ranges[count].VirtualAddress = page;
+        ranges[count].NumberOfBytes = 0x1000;
+        count++;
+    }
+    if (count)
+        NtSetInformationVirtualMemory( GetCurrentProcess(), (VIRTUAL_MEMORY_INFORMATION_CLASS)HB_VM_EMULATOR_TRAP_INFORMATION,
+                                       count, ranges, &trap, sizeof(trap) );

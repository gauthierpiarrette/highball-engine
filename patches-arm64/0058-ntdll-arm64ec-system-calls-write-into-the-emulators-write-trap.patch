+ * page's translations go, the page opens, and they go again (a translation made in between traps the page again). */
+NTSTATUS WINAPI __attribute__((used)) hb_emulator_trap_callback( void **args, ULONG len )
+{
+    MEMORY_RANGE_ENTRY range = { args[0], (SIZE_T)args[1] };

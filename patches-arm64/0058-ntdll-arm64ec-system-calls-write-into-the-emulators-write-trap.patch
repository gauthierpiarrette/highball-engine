+/* Highball: the user callback for a system call's write into the emulator's write trap (unix/signal_arm64.c): the
+ * page's translations go, the page opens, and they go again (a translation made in between traps the page again).
+ * After a write under a Unix lock, the page is open already and the callback runs when the call returns; a range
+ * of size 0 at NULL then means that the emulator drops all its translations. */
+NTSTATUS WINAPI __attribute__((used)) hb_emulator_trap_callback( void **args, ULONG len )
+{
+    MEMORY_RANGE_ENTRY range = { args[0], (SIZE_T)args[1] };
+    ULONG open = 1;
+    BOOL guard = enter_syscall_callback();  /* the emulator's own system calls do not call it back */
+
+    if (pBTCpu64NotifyMemoryDirty) pBTCpu64NotifyMemoryDirty( range.VirtualAddress, range.NumberOfBytes );
+    NtSetInformationVirtualMemory( GetCurrentProcess(), (VIRTUAL_MEMORY_INFORMATION_CLASS)HB_VM_EMULATOR_OPEN_TRAP,
+                                   1, &range, &open, sizeof(open) );
+    if (pBTCpu64NotifyMemoryDirty) pBTCpu64NotifyMemoryDirty( range.VirtualAddress, range.NumberOfBytes );
+    if (guard) leave_syscall_callback();
+    return STATUS_SUCCESS;
+}

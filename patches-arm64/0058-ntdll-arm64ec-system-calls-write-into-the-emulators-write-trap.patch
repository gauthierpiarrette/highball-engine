+/**********************************************************************
+ *		hb_trap_redirect, hb_trap_trampoline
+ *
+ * Highball: a system call wrote into a page the emulator made read-execute to see writes into translated code
+ * (virtual.c). The handler sends the thread to hb_trap_trampoline on its kernel stack, below the faulting code: a user
+ * callback hands the page to the emulator and opens it; then brk #0x4847 comes back here and the saved state of the
+ * faulting write takes its place, and the write runs again.
+ */
+#ifdef __APPLE__
+static void hb_trap_trampoline( void *page, ULONG_PTR size )
+{
+    struct thread_data *data = get_thread_data();
+    void *args[2] = { page, (void *)size }, *ret_ptr;
+    ULONG ret_len;
+
+    data->hb_trap_callback = TRUE;
+    if (KeUserModeCallback( HB_CALLBACK_EMULATOR_TRAP, args, sizeof(args), &ret_ptr, &ret_len ))
+    {
+        /* no callback (no room on the kernel stack): open the page without the emulator, or the write faults again */
+        MEMORY_RANGE_ENTRY range = { page, size };
+        ULONG open = 1;
+
+        WARN( "the user callback for %p failed\n", page );
+        NtSetInformationVirtualMemory( GetCurrentProcess(), (VIRTUAL_MEMORY_INFORMATION_CLASS)HB_VM_EMULATOR_OPEN_TRAP,
+                                       1, &range, &open, sizeof(open) );
+    }
+    data->hb_trap_callback = FALSE;
+    __asm__ volatile( "brk #0x4847" );
+    for (;;) abort_thread( 1 );
+}
+
+static BOOL hb_trap_redirect( struct thread_data *data, ucontext_t *sigcontext, void *addr )
+{
+    struct __darwin_mcontext64 *saved;
+    ULONG_PTR sp = SP_sig(sigcontext) - 128 /* red zone */ - sizeof(*saved);
+
+    sp &= ~(ULONG_PTR)15;
+    saved = (struct __darwin_mcontext64 *)sp;
+    *saved = *sigcontext->uc_mcontext;
+    data->hb_trap_saved = saved;
+    SP_sig(sigcontext) = sp - 16;
+    PC_sig(sigcontext) = (ULONG_PTR)hb_trap_trampoline;
+    LR_sig(sigcontext) = 0;
+    FP_sig(sigcontext) = 0;
+    REGn_sig( 0, sigcontext ) = (ULONG_PTR)addr & ~(ULONG_PTR)(get_host_page_size() - 1);
+    REGn_sig( 1, sigcontext ) = get_host_page_size();
+    return TRUE;
+}
+
+static BOOL hb_trap_return( struct thread_data *data, ucontext_t *sigcontext, DWORD64 esr )
+{
+    if (ESR_ELx_EC(esr) != ESR_ELx_EC_BRK64 || ESR_ELx_ISS_BRK_COMMENT(esr) != 0x4847 || !data->hb_trap_saved) return FALSE;
+    *sigcontext->uc_mcontext = *(struct __darwin_mcontext64 *)data->hb_trap_saved;
+    data->hb_trap_saved = NULL;
+    return TRUE;
+}
+#else
+static BOOL hb_trap_redirect( struct thread_data *data, ucontext_t *sigcontext, void *addr ) { return FALSE; }
+static BOOL hb_trap_return( struct thread_data *data, ucontext_t *sigcontext, DWORD64 esr ) { return FALSE; }
+#endif

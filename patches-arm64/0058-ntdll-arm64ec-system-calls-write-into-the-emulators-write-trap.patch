+#define HB_VM_EMULATOR_TRAP_INFORMATION 0x4842
+static void hb_mark_emulator_trap( void *addr, SIZE_T size, ULONG prot )
+{
+    static const ULONG writable = PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;

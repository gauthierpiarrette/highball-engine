+
+/***********************************************************************
+ *           hb_syscall_notify
+ *
+ * Called by the dispatcher on the return of such a system call, with no Unix lock held: the user callback hands
+ * each page to the emulator, as for a write without a lock. Returns its argument (the syscall's x0).
+ */
+ULONG_PTR hb_syscall_notify( ULONG_PTR x0 )
+{
+    struct thread_data *data = get_thread_data();
+    struct syscall_frame *frame = get_syscall_frame( data );
+    void *args[2], *ret_ptr;
+    ULONG ret_len;
+    int i, count;
+
+    frame->restore_flags &= ~RESTORE_FLAGS_HB_NOTIFY;
+    count = data->hb_notify_count;
+    data->hb_notify_count = 0;
+    data->hb_trap_callback = TRUE;
+    if (count < 0)  /* too many pages: the emulator drops all its translations */
+    {
+        args[0] = NULL;
+        args[1] = 0;
+        KeUserModeCallback( HB_CALLBACK_EMULATOR_TRAP, args, sizeof(args), &ret_ptr, &ret_len );
+    }
+    for (i = 0; i < count; i++)
+    {
+        args[0] = data->hb_notify_pages[i];
+        args[1] = (void *)(ULONG_PTR)get_host_page_size();
+        KeUserModeCallback( HB_CALLBACK_EMULATOR_TRAP, args, sizeof(args), &ret_ptr, &ret_len );
+    }
+    data->hb_trap_callback = FALSE;
+    return x0;
+}

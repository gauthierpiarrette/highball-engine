 /* mmap() anonymous memory at a fixed address */
+#if defined(__APPLE__) && defined(__aarch64__)
+/* Highball spike 2026-10-04: arm64 macOS has no RWX pages. Read-write-execute memory is kept as plain
+ * anonymous memory whose host pages flip between read-write and read-execute on faults. (MAP_JIT was
+ * tried first: a thread-state flip made inside a signal handler does not survive the return from it.)
+ * Code inside PE images stays read-execute; a mixed 16K page flips the same way. */
+#define HB_JIT 1
+#include <pthread.h>
+struct jit_range { char *base; size_t size; };
+static struct jit_range jit_ranges[2048];
+static unsigned int jit_count;
+
+static BOOL is_jit_addr( const void *addr )
+{
+    unsigned int i;
+    for (i = 0; i < jit_count; i++)
+        if ((const char *)addr >= jit_ranges[i].base && (const char *)addr < jit_ranges[i].base + jit_ranges[i].size) return TRUE;
+    return FALSE;
+}
+
+static void remove_jit_ranges( const void *base, size_t size )
+{
+    unsigned int i = 0;
+    const char *end = (const char *)base + size;
+    while (i < jit_count)
+    {
+        if (jit_ranges[i].base < end && jit_ranges[i].base + jit_ranges[i].size > (const char *)base)
+            jit_ranges[i] = jit_ranges[--jit_count];
+        else i++;
+    }
+}
+
+static void add_jit_range( void *base, size_t size )
+{
+    unsigned int i;
+    remove_jit_ranges( base, size );
+    for (i = 0; i < jit_count; i++)   /* merge with a neighbour */
+    {
+        if (jit_ranges[i].base + jit_ranges[i].size == (char *)base) { jit_ranges[i].size += size; return; }
+        if ((char *)base + size == jit_ranges[i].base) { jit_ranges[i].base = base; jit_ranges[i].size += size; return; }
+    }
+    if (jit_count < sizeof(jit_ranges) / sizeof(jit_ranges[0]))
+    {
+        jit_ranges[jit_count].base = base;
+        jit_ranges[jit_count].size = size;
+        jit_count++;
+    }
+    else ERR( "too many JIT ranges\n" );
+}
+
+/* read-write-execute memory on arm64 macOS: keep it read-write and flip single host pages to read-execute
+ * when they are executed and back when they are written (virtual_handle_fault); a page is never RWX */
+static int make_jit_range( char *base, size_t size )
+{
+    if (mprotect( base, size, PROT_READ | PROT_WRITE )) return -1;
+    add_jit_range( base, size );
+    TRACE( "W^X range %p-%p\n", base, base + size );
+    return 0;
+}
+#endif
+
 void *anon_mmap_fixed( void *start, size_t size, int prot, int flags )
 {
     assert( !((UINT_PTR)start & host_page_mask) );
     assert( !(size & host_page_mask) );
 
+#ifdef HB_JIT
+    remove_jit_ranges( start, size );
+    if ((prot & PROT_WRITE) && (prot & PROT_EXEC))
+    {
+        void *ret = mmap( start, size, prot & ~PROT_EXEC, MAP_PRIVATE | MAP_ANON | MAP_FIXED | flags, -1, 0 );
+        if (ret != MAP_FAILED) add_jit_range( ret, size );
+        return ret;
+    }
+#endif
     return mmap( start, size, prot, MAP_PRIVATE | MAP_ANON | MAP_FIXED | flags, -1, 0 );
 }
 

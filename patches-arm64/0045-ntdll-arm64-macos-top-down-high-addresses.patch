         if (limit_high && (void *)limit_high < end) end = (char *)limit_high + 1;
+
+#if defined(__APPLE__) && defined(__aarch64__)
+        /* The arm64 loader reserves only low memory. Windows top-down requests
+         * must search high addresses before consuming the space near PE images.
+         * Internal Wine mappings retain their existing placement policy. */
+        if (prefer_high && top_down && end > (void *)limit_4g &&

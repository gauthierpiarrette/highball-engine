-    if (virtual_check_buffer_for_read( buffer, size ))
+    if (process == GetCurrentProcess())
+    {
+        /* The server writes through the Mach task port on macOS, which it is refused for
+         * our own process; write our own memory here, as NtReadVirtualMemory reads it. */
+        if (!virtual_check_buffer_for_read( buffer, size ))
+        {
+            status = STATUS_PARTIAL_COPY;
+            size = 0;
+        }
+        else if ((status = virtual_uninterrupted_write_memory( addr, buffer, size )))
+        {
+            status = STATUS_PARTIAL_COPY;
+            size = 0;
+        }
+    }
+    else if (virtual_check_buffer_for_read( buffer, size ))
     {
         SERVER_START_REQ( write_process_memory )
         {

+/* Highball: a page the emulator made read-execute to see writes into translated code is still writable for the
+ * program, so a write into it from WriteProcessMemory succeeds on Windows. Where the direct write fails on such
+ * a page, give it back the protection the program set, through NtProtectVirtualMemory so the emulator drops its
+ * translations of that page, and write again. The emulator protects the page again when it translates it. */
+NTSTATUS SYSCALL_API NtWriteVirtualMemory( HANDLE process, void *addr, const void *buffer, SIZE_T size,
+                                           SIZE_T *bytes_written )
+{
+    NTSTATUS status = syscall_NtWriteVirtualMemory( process, addr, buffer, size, bytes_written );
+    ULONG_PTR page, end;
+    BOOL changed = FALSE;
+
+    if (status != STATUS_PARTIAL_COPY || !size || !pGuestProtection || !RtlIsCurrentProcess( process ))
+        return status;
+
+    end = (ULONG_PTR)addr + size;
+    if (end < (ULONG_PTR)addr) return status;
+    for (page = (ULONG_PTR)addr & ~(page_size - 1); page < end; page += page_size)
+    {
+        MEMORY_BASIC_INFORMATION info;
+        ULONG guest, old;
+        void *base = (void *)page;
+        SIZE_T len = page_size;
+
+        if (syscall_NtQueryVirtualMemory( process, base, MemoryBasicInformation, &info, sizeof(info), NULL ) ||
+            info.State != MEM_COMMIT)
+            return status;
+        if (info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY))
+            continue;
+        guest = pGuestProtection( base, info.Protect );
+        if (!(guest & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY)))
+            return status;
+        if (NtProtectVirtualMemory( process, &base, &len, guest, &old )) return status;
+        changed = TRUE;
+    }
+    if (!changed) return status;
+    return syscall_NtWriteVirtualMemory( process, addr, buffer, size, bytes_written );
+}
+
 /* Highball: a page the emulator made read-execute to see writes into translated code reads back with the protection
  * the program set itself, as on Windows, where no such step exists */
 NTSTATUS SYSCALL_API NtQueryVirtualMemory( HANDLE process, LPCVOID addr, MEMORY_INFORMATION_CLASS info_class,

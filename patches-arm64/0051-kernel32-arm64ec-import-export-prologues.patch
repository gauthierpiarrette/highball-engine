Subject: [PATCH] kernel32: give ARM64EC imported exports x64 entry prologues

ARM64EC import exports delegated to lld start with a bare indirect jump.
The equivalent x64 Wine exports have an eight-byte hotpatch prologue.
Provide x64 entry points for kernel32's imported ARM64EC functions, with
the same no-op prologue and the same IAT destination. Other architectures
and non-imported exports retain their existing handling.

The forwarder list is selected from the Wine 11.18 ARM64EC spec. The code
adds no DLL or runtime dependency. Existing syscall/context/memory/fiber
checks pass, and a prototype reached FH6's title, Xbox sign-in, main menu
and shader optimization on M4. One prototype repeat stalled during
saved-account loading; the reproducible patch build subsequently loaded
the cached account, cloud save and main menu. Gameplay, a complete repeat
and same-build control remain pending; this is not a compatibility claim.

Related report: https://bugs.winehq.org/show_bug.cgi?id=60463

diff --git a/tools/winebuild/spec32.c b/tools/winebuild/spec32.c
--- a/tools/winebuild/spec32.c
+++ b/tools/winebuild/spec32.c
@@ -425,6 +425,9 @@
             if (!odp) continue;
             if (odp->flags & FLAG_FORWARD)
                 symbol = odp->link_name;
+            else if ((odp->flags & FLAG_IMPORT) && odp->name && odp->type != TYPE_EXTERN &&
+                     (!strcmp( spec->file_name, "KERNEL32.dll" ) || !strcmp( spec->file_name, "kernel32.dll" )))
+                symbol = strmake( "__wine_spec_imp_%s", odp->name );
             else if (odp->flags & FLAG_EXT_LINK)
                 symbol = strmake( "%s_%s", asm_name("__wine_spec_ext_link"), odp->link_name );
             else
diff --git a/dlls/kernel32/Makefile.in b/dlls/kernel32/Makefile.in
--- a/dlls/kernel32/Makefile.in
+++ b/dlls/kernel32/Makefile.in
@@ -15,6 +15,7 @@
 	debugger.c \
 	file.c \
 	heap.c \
+	import_thunks_x64.c \
 	kernel_main.c \
 	locale.c \
 	lzexpand.c \
diff --git a/dlls/kernel32/import_thunks_x64.c b/dlls/kernel32/import_thunks_x64.c
new file mode 100644
--- /dev/null
+++ b/dlls/kernel32/import_thunks_x64.c
@@ -0,0 +1,814 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* x64 entry points for kernel32's ARM64EC imported exports.
+ * Selected from Wine 11.18 kernel32.spec by winebuild for ARM64EC.
+ * Regenerate this list if that spec's imported exports change. */
+#if 0
+#pragma makedep arm64ec_x64
+#endif
+
+#ifdef __arm64ec_x64__
+#include "windef.h"
+#include "wine/asm.h"
+
+#define IMPORT_ALIAS(name,target) \
+    __ASM_GLOBAL_FUNC( __wine_spec_imp_##name, \
+                      ".seh_endprologue\n\t" \
+                      ".byte 0x48,0x8d,0xa4,0x24,0,0,0,0\n\t" \
+                      "jmp *__imp_" #target "(%rip)" )
+#define IMPORT_ENTRY(name) IMPORT_ALIAS(name,name)

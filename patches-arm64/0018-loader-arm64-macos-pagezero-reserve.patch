+#elif defined(__APPLE__) && defined(__aarch64__) && !defined(HAVE_WINE_PRELOADER)
+
+/* Highball spike 2026-10-04: arm64 macOS has no preloader and a PAGEZERO of 4 GB or more.
+ * With the cross-architecture entitlement the kernel lets the process map over __PAGEZERO,
+ * so hand that range to Wine as its reserved low memory (CrossOver links the loader with a
+ * PAGEZERO of about 0x170000000 for the same reason). */
+#include <mach-o/getsect.h>
+
+static struct wine_preload_info preload_info[2];
+
+const __attribute((visibility("default"))) struct wine_preload_info *wine_main_preload_info = preload_info;
+
+static void init_reserved_areas(void)
+{
+    const struct segment_command_64 *seg = getsegbyname( "__PAGEZERO" );
+
+    if (seg && seg->vmsize > 0x10000)
+    {
+        preload_info[0].addr = (void *)0x10000;  /* host page aligned, Wine allocation granularity */
+        preload_info[0].size = seg->vmsize - 0x10000;
+        /* no PROT_NONE pre-mapping here: nothing else can allocate inside __PAGEZERO, and Wine
+         * maps into the reserved range with MAP_FIXED and the final protection itself */
+    }
+}
+
 #else
 
 /* the preloader will set this variable */

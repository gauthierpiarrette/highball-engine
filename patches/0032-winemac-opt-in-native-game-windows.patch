+    if (EqualRect(&data->rects.window, &data->rects.visible) && !game_window &&
         !is_main_steam_window(data->hwnd, style, ex_style)) return wf;
 
     /* CrossOver Hack #16933 */
@@ -148,7 +153,14 @@
         return wf;
     }
 
-    return get_window_features_for_style(style, ex_style, data->shaped);
+    wf = get_window_features_for_style(style, ex_style, data->shaped);
+    /* AppKit requires a resizable style for a full-screen Space. */
+    if (game_window)
+    {
+        wf.resizable = TRUE;
+        wf.native_game_window = TRUE;
+    }
+    return wf;
 }
 
 

+/***********************************************************************
+ *              macdrv_mouse_thread_init
+ *
+ * Runs on the mouse thread: gives it an event queue and makes that queue the
+ * one Cocoa posts mouse input to while the mouse is locked.
+ */
+static NTSTATUS macdrv_mouse_thread_init(void *arg)
+{
+    struct macdrv_thread_data *data = macdrv_init_thread_data();
+    macdrv_set_mouse_input_queue(data->queue);
+    TRACE("mouse thread ready\n");
+    return 0;
+}
+
+
+/***********************************************************************
+ *              macdrv_start_mouse_thread
+ *
+ * Starts the mouse thread the first time a program confines the cursor.
+ */
+void macdrv_start_mouse_thread(void)
+{
+    static LONG started;
+    struct start_mouse_thread_params params = {.dispatch = {.callback = start_mouse_thread_callback}};
+    void *ret_ptr;
+    ULONG ret_len;
+
+    if (!mouse_thread_enabled || !start_mouse_thread_callback) return;
+    if (InterlockedCompareExchange(&started, 1, 0)) return;
+    KeUserDispatchCallback(&params.dispatch, sizeof(params), &ret_ptr, &ret_len);
+}
+

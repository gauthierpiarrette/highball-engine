+/***********************************************************************
+ *              macdrv_set_mouse_input_queue
+ *
+ * Make the given queue (the mouse thread's) receive mouse input while the
+ * mouse is locked.
+ */
+void macdrv_set_mouse_input_queue(macdrv_event_queue queue)
+{
+    WineEventQueue* q = [(WineEventQueue*)queue retain];
+    OnMainThreadAsync(^{
+        [mouseInputQueue release];
+        mouseInputQueue = q;
+    });
+}

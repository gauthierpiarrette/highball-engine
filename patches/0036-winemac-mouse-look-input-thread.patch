+/***********************************************************************
+ *              macdrv_mouse_thread
+ *
+ * While a program has the cursor hidden and confined (mouse look), the Mac
+ * driver sends mouse input from this thread as soon as it arrives instead of
+ * waiting for the program's window thread to pump messages.  Programs that
+ * read raw input on another thread (SDL 3 does) then see movement in the
+ * frame it happened, as on Windows.
+ */
+static DWORD WINAPI macdrv_mouse_thread(void *arg)
+{
+    MSG msg;
+
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    if (MACDRV_CALL(mouse_thread_init, NULL)) return 0;
+    for (;;)
+    {
+        MsgWaitForMultipleObjectsEx(0, NULL, INFINITE, QS_ALLINPUT, 0);
+        while (PeekMessageW(&msg, 0, 0, 0, PM_REMOVE)) DispatchMessageW(&msg);
+    }
+    return 0;
+}
+
+static NTSTATUS WINAPI macdrv_start_mouse_thread(void *arg, ULONG size)
+{
+    HANDLE thread = CreateThread(NULL, 0, macdrv_mouse_thread, NULL, 0, NULL);
+    if (!thread) return STATUS_UNSUCCESSFUL;
+    CloseHandle(thread);
+    return STATUS_SUCCESS;
+}
+
 static BOOL process_attach(void)
 {
     struct init_params params;
@@ -488,6 +519,7 @@ static BOOL process_attach(void)
     params.regcreateopenkeyexa_callback = (UINT_PTR)macdrv_regcreateopenkeyexa;
     params.regsetvalueexa_callback = (UINT_PTR)macdrv_regsetvalueexa;
     params.regqueryvalueexa_callback = (UINT_PTR)macdrv_regqueryvalueexa;
+    params.start_mouse_thread_callback = (UINT_PTR)macdrv_start_mouse_thread;
 
     if (MACDRV_CALL(init, &params)) return FALSE;
 

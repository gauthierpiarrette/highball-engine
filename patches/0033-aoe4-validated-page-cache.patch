+/* Keep the epoch odd for the entire outermost VM critical section, including
+ * protection changes made by signal handlers. Never retain file_view pointers. */
+static void lock_virtual(void)
+{
+    mutex_lock( &virtual_mutex );
+#if defined(__APPLE__) && defined(__x86_64__)
+    if (aoe_vm_tracking && !aoe_vm_depth++)
+        __atomic_add_fetch( &aoe_vm_epoch, 1, __ATOMIC_ACQ_REL );
+#endif
+}
+
+static void unlock_virtual(void)
+{
+#if defined(__APPLE__) && defined(__x86_64__)
+    if (aoe_vm_tracking && !--aoe_vm_depth)
+        __atomic_add_fetch( &aoe_vm_epoch, 1, __ATOMIC_RELEASE );
+#endif
+    mutex_unlock( &virtual_mutex );
+}
+
+static void enter_virtual_section(sigset_t *sigset)
+{
+    pthread_sigmask( SIG_BLOCK, &server_block_set, sigset );
+    lock_virtual();
+}
+
+static void leave_virtual_section(sigset_t *sigset)
+{
+    unlock_virtual();
+    pthread_sigmask( SIG_SETMASK, sigset, NULL );
+}

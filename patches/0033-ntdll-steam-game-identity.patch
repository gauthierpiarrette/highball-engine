+# include <dirent.h>
+# include <stdbool.h>
 # ifndef _POSIX_SPAWN_DISABLE_ASLR
 #  define _POSIX_SPAWN_DISABLE_ASLR 0x0100
 # endif
@@ -800,8 +803,120 @@
     argv[1] = strdup( wineloader );
     preloader_exec( argv, image_path, machine );
     return STATUS_INVALID_IMAGE_FORMAT;
+}
+
+
+#if defined(__APPLE__) && defined(__x86_64__)
+/* Highball's named game bundle is selected using the resolved PE image path,
+ * which is available here even when a long-running Steam client starts it. */
+typedef int (*disclaim_func)(posix_spawnattr_t *, bool);
+
+static bool real_game_path(const char *prefix, const char *image, char *out)
+{
+    char path[PATH_MAX], *p;
+    size_t start;
+    int n;
+
+    if (!strncmp(image, "\\??\\", 4) || !strncmp(image, "\\\\?\\", 4)) image += 4;
+    if (image[0] == '/') return realpath(image, out) != NULL;
+    if (!isalpha((unsigned char)image[0]) || image[1] != ':' ||
+        (image[2] != '\\' && image[2] != '/')) return false;
+
+    n = snprintf(path, sizeof(path), "%s/dosdevices/%c:/%s", prefix,
+                 tolower((unsigned char)image[0]), image + 3);
+    if (n < 0 || n >= (int)sizeof(path)) return false;
+    start = (size_t)n - strlen(image + 3);
+    for (p = path + start; *p; ++p) if (*p == '\\') *p = '/';
+    return realpath(path, out) != NULL;
+}
+
+static bool identity_loader(const char *prefix, const char *image, char *out)
+{
+    char actual[PATH_MAX], root[PATH_MAX];
+    struct dirent *entry;
+    bool match = false;
+    DIR *dir;
+    int n;
+
+    n = snprintf(root, sizeof(root), "%s/highball-identities", prefix);
+    if (n < 0 || n >= (int)sizeof(root) || !(dir = opendir(root))) return false;
+    if (!real_game_path(prefix, image, actual))
+    {
+        closedir(dir);
+        return false;
+    }
+
+    while (!match && (entry = readdir(dir)))
+    {
+        const char *name = entry->d_name;
+        size_t digits, bundle_len, len;
+        char map[PATH_MAX], line[PATH_MAX + 2], bundle[NAME_MAX + 2];
+        FILE *file;
+
+        if (strncmp(name, "steam-", 6)) continue;
+        digits = strspn(name + 6, "0123456789");
+        if (!digits || strcmp(name + 6 + digits, ".paths")) continue;
+
+        n = snprintf(map, sizeof(map), "%s/%s", root, name);
+        if (n < 0 || n >= (int)sizeof(map) || !(file = fopen(map, "r"))) continue;
+        if (!fgets(bundle, sizeof(bundle), file))
+        {
+            fclose(file);
+            continue;
+        }
+        bundle_len = strlen(bundle);
+        if (bundle_len < 6 || bundle[bundle_len - 1] != '\n' ||
+            memcmp(bundle + bundle_len - 5, ".app", 4) ||
+            strchr(bundle, '/') || strchr(bundle, '\\'))
+        {
+            fclose(file);
+            continue;
+        }
+        bundle[bundle_len - 1] = 0;
+        while (fgets(line, sizeof(line), file))
+        {
+            len = strlen(line);
+            if (!len || line[len - 1] != '\n') continue;
+            line[len - 1] = 0;
+            if (strcmp(line, actual)) continue;
+            n = snprintf(out, PATH_MAX, "%s/%.*s/%s/Contents/MacOS/wine", root,
+                         (int)(6 + digits), name, bundle);
+            match = n > 0 && n < PATH_MAX && access(out, X_OK) == 0;
+            break;
+        }
+        fclose(file);
+    }
+    closedir(dir);
+    return match;
 }
+
+static void exec_identity_loader( char **argv, const char *image_path )
+{
+    posix_spawnattr_t attr;
+    char loader[PATH_MAX];
+    const char *prefix = getenv( "WINEPREFIX" );
+    disclaim_func disclaim;
+    int error;
+
+    if (!prefix || !image_path || !identity_loader( prefix, image_path, loader )) return;
+    disclaim = (disclaim_func)dlsym( RTLD_DEFAULT, "responsibility_spawnattrs_setdisclaim" );
+    if (!disclaim || posix_spawnattr_init( &attr )) return;
+    error = posix_spawnattr_setflags( &attr, POSIX_SPAWN_SETEXEC );
+    if (!error) error = disclaim( &attr, true );
+    if (!error)
+    {
+        char *previous = argv[1];
+        static char noexec[] = "WINELOADERNOEXEC=1";
 
+        argv[1] = loader;
+        putenv( noexec );
+        error = posix_spawn( NULL, loader, NULL, &attr, argv + 1, environ );
+        argv[1] = previous;
+    }
+    posix_spawnattr_destroy( &attr );
+    WARN( "Named loader %s failed: %s\n", loader, strerror( error ) );
+}
+#endif
 
 /***********************************************************************

+#ifdef __APPLE__
+/* %gs:0x20, %gs:0x08 and %gs:0x10 are PE-owned while PE code runs (Tib.FiberData, StackBase and
+ * StackLimit, which a program running its own fiber system writes itself) and the host's while unix
+ * code runs (the pthread QoS slot, the errno pointer, the MIG reply port). The TEB fields are the
+ * PE-side store (what PE code last left in a slot goes there on entry to unix code and comes back on
+ * return), host_qos, host_errno and host_mig the host-side store. The dispatchers swap on the kernel
+ * stack on entry and on the user stack on return, so "%rsp inside the syscall region" and "the slots
+ * are the host's" always go together, and a signal handler does the same here. Each slot is swapped
+ * only while it still holds the other side's value, so repeating a swap stashes nothing wrong, and
+ * nothing is done before call_init_thunk captured the host's values (host_errno is never zero). */
+static inline void pe_slots_to_host( TEB *teb )
+{
+    struct amd64_thread_data *data = (struct amd64_thread_data *)((struct ntdll_thread_data *)&teb->GdiTebBatch)->cpu_data;
+    void *v;
+
+    if (!data->host_errno) return;
+    __asm__ volatile( "movq %%gs:0x20,%0" : "=r" (v) );
+    if (v != (void *)data->host_qos)
+    {
+        teb->Tib.FiberData = v;
+        __asm__ volatile( "movq %0,%%gs:0x20" :: "r" (data->host_qos) );
+    }
+    __asm__ volatile( "movq %%gs:0x08,%0" : "=r" (v) );
+    if (v != (void *)data->host_errno)
+    {
+        teb->Tib.StackBase = v;
+        __asm__ volatile( "movq %0,%%gs:0x08" :: "r" (data->host_errno) );
+    }
+    __asm__ volatile( "movq %%gs:0x10,%0" : "=r" (v) );
+    if (v != (void *)data->host_mig)
+    {
+        teb->Tib.StackLimit = v;
+        __asm__ volatile( "movq %0,%%gs:0x10" :: "r" (data->host_mig) );
+    }
+}
+
+static inline void pe_slots_to_pe( TEB *teb )
+{
+    struct amd64_thread_data *data = (struct amd64_thread_data *)((struct ntdll_thread_data *)&teb->GdiTebBatch)->cpu_data;
+    void *v;
+
+    if (!data->host_errno) return;
+    __asm__ volatile( "movq %%gs:0x20,%0" : "=r" (v) );
+    if (v != teb->Tib.FiberData)
+    {
+        data->host_qos = (DWORD_PTR)v;
+        __asm__ volatile( "movq %0,%%gs:0x20" :: "r" (teb->Tib.FiberData) );
+    }
+    __asm__ volatile( "movq %%gs:0x08,%0" : "=r" (v) );
+    if (v != teb->Tib.StackBase)
+    {
+        data->host_errno = (DWORD_PTR)v;
+        __asm__ volatile( "movq %0,%%gs:0x08" :: "r" (teb->Tib.StackBase) );
+    }
+    __asm__ volatile( "movq %%gs:0x10,%0" : "=r" (v) );
+    if (v != teb->Tib.StackLimit)
+    {
+        data->host_mig = (DWORD_PTR)v;
+        __asm__ volatile( "movq %0,%%gs:0x10" :: "r" (teb->Tib.StackLimit) );
+    }
+}
+#endif
 
 

+#ifdef __APPLE__
+/* %gs:0x20 is PE-owned while PE code runs (Tib.FiberData) and the host's pthread QoS slot while unix code
+ * runs. %gs:0x08 and %gs:0x10 are the host's errno pointer and MIG reply port on both sides until PE code
+ * writes one of them (a program running its own fiber system keeps NT_TIB.StackBase and StackLimit there,
+ * Boost.Context style): from then on that slot is PE-owned too, what PE left there goes into the TEB
+ * field on entry to unix code and comes back on return (pe_slot_flags remembers which), and when PE code
+ * writes the host's value back (its main context saved what it found there at its first switch) the
+ * TEB field returns to the thread's own bounds (pe_main_base, pe_main_limit). PE mode cannot
+ * simply hold the TEB fields: D3DMetal's PE DLLs call host code directly on the PE stack and the first
+ * failing syscall writes errno through %gs:0x08. The TEB fields are the PE-side store, host_qos,
+ * host_errno and host_mig the host-side one. The dispatchers swap on the kernel stack on entry and on the
+ * user stack on return, so "%rsp inside the syscall region" and "the slots are the host's" always go
+ * together, and a signal handler does the same here. Each slot is swapped only while it still holds the
+ * other side's value, so repeating a swap stashes nothing wrong, and nothing is done before
+ * call_init_thunk captured the host's values (host_errno is never zero). */
+static inline void pe_slots_to_host( TEB *teb )
+{
+    struct ntdll_thread_data *tdata = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    struct amd64_thread_data *data = (struct amd64_thread_data *)tdata->cpu_data;
+    void *v;
+
+    if (!data->host_errno) return;
+    __asm__ volatile( "movq %%gs:0x20,%0" : "=r" (v) );
+    if (v != (void *)data->host_qos)
+    {
+        teb->Tib.FiberData = v;
+        __asm__ volatile( "movq %0,%%gs:0x20" :: "r" (data->host_qos) );
+    }
+    __asm__ volatile( "movq %%gs:0x08,%0" : "=r" (v) );
+    if (v != (void *)data->host_errno)
+    {
+        teb->Tib.StackBase = v;
+        data->pe_slot_flags |= 1;
+        __asm__ volatile( "movq %0,%%gs:0x08" :: "r" (data->host_errno) );
+    }
+    else if (data->pe_slot_flags & 1)  /* PE code put the host value back: its main context, the thread's own stack */
+    {
+        data->pe_slot_flags &= ~1;
+        teb->Tib.StackBase = tdata->pe_main_base;
+    }
+    __asm__ volatile( "movq %%gs:0x10,%0" : "=r" (v) );
+    if (v != (void *)data->host_mig)
+    {
+        teb->Tib.StackLimit = v;
+        data->pe_slot_flags |= 2;
+        __asm__ volatile( "movq %0,%%gs:0x10" :: "r" (data->host_mig) );
+    }
+    else if (data->pe_slot_flags & 2)
+    {
+        data->pe_slot_flags &= ~2;
+        teb->Tib.StackLimit = tdata->pe_main_limit;
+    }
+}
 
+static inline void pe_slots_to_pe( TEB *teb )
+{
+    struct amd64_thread_data *data = (struct amd64_thread_data *)((struct ntdll_thread_data *)&teb->GdiTebBatch)->cpu_data;
+    void *v;
 
+    if (!data->host_errno) return;
+    __asm__ volatile( "movq %%gs:0x20,%0" : "=r" (v) );
+    if (v != teb->Tib.FiberData)
+    {
+        data->host_qos = (DWORD_PTR)v;
+        __asm__ volatile( "movq %0,%%gs:0x20" :: "r" (teb->Tib.FiberData) );
+    }
+    if (data->pe_slot_flags & 1)
+    {
+        __asm__ volatile( "movq %%gs:0x08,%0" : "=r" (v) );
+        if (v != teb->Tib.StackBase)
+        {
+            data->host_errno = (DWORD_PTR)v;
+            __asm__ volatile( "movq %0,%%gs:0x08" :: "r" (teb->Tib.StackBase) );
+        }
+    }
+    if (data->pe_slot_flags & 2)
+    {
+        __asm__ volatile( "movq %%gs:0x10,%0" : "=r" (v) );
+        if (v != teb->Tib.StackLimit)
+        {
+            data->host_mig = (DWORD_PTR)v;
+            __asm__ volatile( "movq %0,%%gs:0x10" :: "r" (teb->Tib.StackLimit) );
+        }
+    }
+}

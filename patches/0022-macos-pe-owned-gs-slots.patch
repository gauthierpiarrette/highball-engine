+#ifdef __APPLE__
+/* %gs:0x20, %gs:0x08 and %gs:0x10 are PE-owned while PE code runs (Tib.FiberData, StackBase and
+ * StackLimit, which a program running its own fiber system writes itself) and the host's while unix
+ * code runs (the pthread QoS slot, the errno pointer, the MIG reply port). The dispatchers swap them
+ * on the kernel stack on entry and on the user stack on return, so "%rsp inside the syscall region"
+ * and "the slots are the host's" always go together, and a signal handler does the same here. Each
+ * slot is swapped only while it still holds the other side's value, so repeating a swap stashes
+ * nothing wrong, and nothing is done before call_init_thunk captured the host's values
+ * (Instrumentation[3], the errno pointer, is never zero afterwards). */
+static inline void pe_slots_to_host( TEB *teb )
+{
+    struct amd64_thread_data *data = (struct amd64_thread_data *)((struct ntdll_thread_data *)&teb->GdiTebBatch)->cpu_data;
+    void *v;
+
+    if (!teb->Instrumentation[3]) return;
+    __asm__ volatile( "movq %%gs:0x20,%0" : "=r" (v) );
+    if (v != (void *)data->host_qos)
+    {
+        data->pe_fiber = (DWORD_PTR)v;
+        __asm__ volatile( "movq %0,%%gs:0x20" :: "r" (data->host_qos) );
+    }
+    __asm__ volatile( "movq %%gs:0x08,%0" : "=r" (v) );
+    if (v != teb->Instrumentation[3])
+    {
+        teb->Instrumentation[1] = v;
+        __asm__ volatile( "movq %0,%%gs:0x08" :: "r" (teb->Instrumentation[3]) );
+    }
+    __asm__ volatile( "movq %%gs:0x10,%0" : "=r" (v) );
+    if (v != teb->Instrumentation[4])
+    {
+        teb->Instrumentation[2] = v;
+        __asm__ volatile( "movq %0,%%gs:0x10" :: "r" (teb->Instrumentation[4]) );
+    }
+}
+
+static inline void pe_slots_to_pe( TEB *teb )
+{
+    struct amd64_thread_data *data = (struct amd64_thread_data *)((struct ntdll_thread_data *)&teb->GdiTebBatch)->cpu_data;
+    void *v;
+
+    if (!teb->Instrumentation[3]) return;
+    __asm__ volatile( "movq %%gs:0x20,%0" : "=r" (v) );
+    if (v != (void *)data->pe_fiber)
+    {
+        data->host_qos = (DWORD_PTR)v;
+        __asm__ volatile( "movq %0,%%gs:0x20" :: "r" (data->pe_fiber) );
+    }
+    __asm__ volatile( "movq %%gs:0x08,%0" : "=r" (v) );
+    if (v != teb->Instrumentation[1])
+    {
+        teb->Instrumentation[3] = v;
+        __asm__ volatile( "movq %0,%%gs:0x08" :: "r" (teb->Instrumentation[1]) );
+    }
+    __asm__ volatile( "movq %%gs:0x10,%0" : "=r" (v) );
+    if (v != teb->Instrumentation[2])
+    {
+        teb->Instrumentation[4] = v;
+        __asm__ volatile( "movq %0,%%gs:0x10" :: "r" (teb->Instrumentation[2]) );
+    }
+}
+#endif
 
 

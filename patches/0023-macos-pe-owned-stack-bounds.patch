+/* NT_TIB.StackBase and StackLimit as the program sees them: at %gs:0x08 and %gs:0x10, which is the TEB
+ * where %gs is the TEB and the PE-owned mirror of the fields on macOS, where a program running its own
+ * fiber system writes them (see the unix side's crossings). */
+#ifdef __x86_64__
+static inline void *tib_stack_base(void) { void *p; __asm__( "movq %%gs:0x08,%0" : "=r" (p) ); return p; }
+static inline void *tib_stack_limit(void) { void *p; __asm__( "movq %%gs:0x10,%0" : "=r" (p) ); return p; }
+#else
+static inline void *tib_stack_base(void) { return NtCurrentTeb()->Tib.StackBase; }
+static inline void *tib_stack_limit(void) { return NtCurrentTeb()->Tib.StackLimit; }
+#endif
+
 static inline BOOL is_valid_frame( ULONG_PTR frame )
 {
     if (frame & (sizeof(void*) - 1)) return FALSE;
-    return ((void *)frame >= NtCurrentTeb()->Tib.StackLimit &&
-            (void *)frame <= NtCurrentTeb()->Tib.StackBase);
+    return ((void *)frame >= tib_stack_limit() &&
+            (void *)frame <= tib_stack_base());
 }
 

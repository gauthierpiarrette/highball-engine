+#elif defined(__APPLE__)
+    /* unix_tid is the Mach thread port name from get_unix_tid(); it is only
+     * meaningful inside the same task. */
+    thread_basic_info_data_t info;
+    mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+
+    if (unix_pid != getpid())
+    {
+        static int once;
+        if (!once++) FIXME("cross-process thread times not supported on this platform\n");

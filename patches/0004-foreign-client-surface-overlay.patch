+/* Highball: the foreign window's rects in screen coordinates. */
+static BOOL foreign_window_rects(HWND hwnd, RECT *window_rect, RECT *client_rect)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    if (!NtUserGetWindowRect(hwnd, window_rect, dpi)) return FALSE;
+    if (!NtUserGetClientRect(hwnd, client_rect, dpi)) return FALSE;
+    NtUserMapWindowPoints(hwnd, 0, (POINT *)client_rect, 2, dpi);
+    return !IsRectEmpty(client_rect);
+}
+
+/***********************************************************************
+ *              macdrv_client_surface_attach_foreign
+ *
+ * Highball: a client surface for a window this process did not create (a
+ * browser's GPU process presenting into the browser window). There is no
+ * Cocoa view of ours to attach to, so the surface's view goes into a
+ * borderless, non-activating overlay window framed on the foreign window's
+ * client rect. The overlay ignores the mouse and follows the foreign window
+ * on every present.
+ */
+BOOL macdrv_client_surface_attach_foreign(struct macdrv_client_surface *surface)
+{
+    struct macdrv_thread_data *thread_data = macdrv_init_thread_data();
+    struct macdrv_window_features wf = { 0 };
+    struct macdrv_window_state state = { 0 };
+    HWND hwnd = surface->client.hwnd;
+    RECT window_rect, client_rect;
+    CGRect frame;
+    DWORD pid = 0;
+
+    if (surface->foreign_window) return TRUE;
+    if (!NtUserIsWindow(hwnd) || !foreign_window_rects(hwnd, &window_rect, &client_rect)) return FALSE;
+    NtUserGetWindowThread(hwnd, &pid);
+    surface->foreign_pid = pid;
+
+    wf.prevents_app_activation = TRUE;
+    frame = cgrect_from_rect(client_rect);
+    surface->foreign_window = macdrv_create_cocoa_window(&wf, frame, hwnd, thread_data->queue);
+    if (!surface->foreign_window) return FALSE;
+
+    state.no_foreground = TRUE;
+    state.excluded_by_expose = TRUE;
+    state.excluded_by_cycle = TRUE;
+    macdrv_set_cocoa_window_state(surface->foreign_window, &state);
+    macdrv_set_cocoa_window_ignores_mouse(surface->foreign_window, true);
+    macdrv_set_view_frame(surface->cocoa_view, CGRectMake(0, 0, frame.size.width, frame.size.height));
+    macdrv_set_view_superview(surface->cocoa_view, NULL, surface->foreign_window, NULL, NULL);
+    macdrv_set_view_hidden(surface->cocoa_view, FALSE);
+    macdrv_client_surface_foreign_update(surface);
+    TRACE("hwnd %p of process %04x: overlay %p at %s\n", hwnd, (unsigned int)pid, surface->foreign_window,
+          wine_dbgstr_rect(&client_rect));
+    return TRUE;
+}
+
+/***********************************************************************
+ *              macdrv_client_surface_foreign_update
+ *
+ * Highball: keep the overlay on the foreign window's client rect and just
+ * above it; hide it while the foreign window is hidden or minimized.
+ */
+void macdrv_client_surface_foreign_update(struct macdrv_client_surface *surface)
+{
+    HWND hwnd = surface->client.hwnd;
+    RECT window_rect, client_rect;
+    CGRect frame;
+    int number;
+
+    if (!surface->foreign_window) return;
+    if (!NtUserIsWindow(hwnd) || !NtUserIsWindowVisible(hwnd) ||
+        (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_MINIMIZE) ||
+        !foreign_window_rects(hwnd, &window_rect, &client_rect))
+    {
+        macdrv_hide_cocoa_window(surface->foreign_window);
+        return;
+    }
+    frame = cgrect_from_rect(client_rect);
+    macdrv_set_cocoa_window_frame(surface->foreign_window, &frame);
+    macdrv_set_view_frame(surface->cocoa_view, CGRectMake(0, 0, frame.size.width, frame.size.height));
+    number = macdrv_find_window_number(surface->foreign_pid, cgrect_from_rect(window_rect));
+    if (number) macdrv_order_cocoa_window_above_number(surface->foreign_window, number);
+    else macdrv_order_cocoa_window(surface->foreign_window, NULL, NULL, FALSE);
+}

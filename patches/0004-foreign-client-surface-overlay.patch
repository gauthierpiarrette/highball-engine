 /***********************************************************************
+ *              macdrv_find_window_number
+ *
+ * Highball: the Cocoa window number of another process's window, found by
+ * owner pid and the top-left corner of its frame (Windows screen coordinates,
+ * which share CG's top-left origin). 0 when nothing matches.
+ */
+int macdrv_find_window_number(int pid, CGRect frame)
+{
+@autoreleasepool
+{
+    int found = 0;
+    CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+                                                 kCGNullWindowID);
+    if (list)
+    {
+        for (NSDictionary* info in (NSArray*)list)
+        {
+            CGRect bounds;
+            if ([info[(id)kCGWindowOwnerPID] intValue] != pid) continue;
+            if ([info[(id)kCGWindowLayer] intValue] != 0) continue;
+            if (!CGRectMakeWithDictionaryRepresentation((CFDictionaryRef)info[(id)kCGWindowBounds], &bounds)) continue;
+            if (fabs(bounds.origin.x - frame.origin.x) <= 2 && fabs(bounds.origin.y - frame.origin.y) <= 2)
+            {
+                found = [info[(id)kCGWindowNumber] intValue];
+                break;
+            }
+        }
+        CFRelease(list);
+    }
+    return found;
+}
+}
+
+/***********************************************************************
+ *              macdrv_order_cocoa_window_above_number
+ *
+ * Highball: order a window of ours directly above a window number that may
+ * belong to another application.
+ */
+void macdrv_order_cocoa_window_above_number(macdrv_window w, int number)
+{
+    WineWindow* window = (WineWindow*)w;
+
+    OnMainThreadAsync(^{
+        [window orderWindow:NSWindowAbove relativeTo:number];
+    });
+}
+
+/***********************************************************************
+ *              macdrv_set_cocoa_window_ignores_mouse
+ *
+ * Highball: an overlay never takes input; clicks fall through to the window
+ * beneath it.
+ */
+void macdrv_set_cocoa_window_ignores_mouse(macdrv_window w, bool ignores)
+{
+    WineWindow* window = (WineWindow*)w;
+
+    OnMainThread(^{
+        [window setIgnoresMouseEvents:ignores];
+    });
+}

+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * GameToMac Wine changes: Marc Ibrahim; extensions: NerRobDog.
+ * Source commit: 711c6fc7559a565c417aab4d52d84b09767a9c1d. */
+/* Experimental opt-in immutable cache; original generated bytes remain untouched. */
+#include <pthread.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <time.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include "aoe_relocate.h"
+#include "aoe_build_guard.h"
+extern BOOL aoe_game_verified;
+extern BOOL aoe_cache_auto_discovered;
+extern uint64_t aoe_cache_pointer_address;
+extern uint64_t aoe_cache_search_start, aoe_cache_search_end;
+#define AOE_CACHE_COUNT 262144u
+#define AOE_CACHE_TABLE (AOE_CACHE_COUNT*2)
+struct aoe_cache_entry { struct aoe_fragment_key key; uint64_t hash; uint32_t slot; };
+static pthread_mutex_t aoe_cache_lock=PTHREAD_MUTEX_INITIALIZER;
+static struct aoe_cache_entry *aoe_cache_entries;
+static BYTE *aoe_cache_code;
+static unsigned aoe_cache_used;
+static int aoe_cache_enabled,aoe_cache_attempted;
+static pthread_once_t aoe_cache_enable_once=PTHREAD_ONCE_INIT;
+static void aoe_cache_check_enabled(void)
+{
+    const char *cache = getenv("AOE4_CACHE");
+    aoe_cache_enabled = aoe_patch_requested() && (!cache || strcmp(cache, "0")) &&
+                        main_argc > 0 && aoe_game_name(main_argv[0]);
+}
+static uint64_t aoe_cache_local_stats[16],*aoe_cache_stats=aoe_cache_local_stats;
+/* NerRobDog: AOELAB_CODE_CACHE_DUMP=1 writes the first 4096 refused fragments (pc + raw bytes) to
+ * $AOELAB_COUNTERS_DIR/codecache-unkeyable-<pid>.txt for offline relocator work. */
+static int aoe_cache_dump_fd=-2;static unsigned aoe_cache_dump_left=4096;
+static void aoe_cache_dump_unkeyable(uint64_t pc,const BYTE *bytes,unsigned n)
+{
+ char line[160];int len;unsigned i;
+ if(aoe_cache_dump_fd==-2){
+  const char *directory=getenv("AOELAB_COUNTERS_DIR");char path[1024];
+  aoe_cache_dump_fd=-1;
+  if(getenv("AOELAB_CODE_CACHE_DUMP")&&directory&&directory[0]=='/'&&snprintf(path,sizeof(path),"%s/codecache-unkeyable-%u.txt",directory,(unsigned)getpid())<(int)sizeof(path))
+   aoe_cache_dump_fd=open(path,O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW,0600);
+ }
+ if(aoe_cache_dump_fd<0||!aoe_cache_dump_left)return;
+ aoe_cache_dump_left--;
+ len=snprintf(line,sizeof(line),"%llx",(unsigned long long)pc);
+ for(i=0;i<n&&len<(int)sizeof(line)-4;i++)len+=snprintf(line+len,sizeof(line)-len," %02x",bytes[i]);
+ if(len<(int)sizeof(line)-1)line[len++]='\n';
+ if(write(aoe_cache_dump_fd,line,len)<0)aoe_cache_dump_left=0;
+}
+static __thread uint64_t aoe_cache_thread_original,aoe_cache_thread_shadow;
+static __thread unsigned aoe_cache_thread_len;
+static void aoe_cache_count(unsigned n){__atomic_fetch_add(&__atomic_load_n(&aoe_cache_stats,__ATOMIC_RELAXED)[n],1,__ATOMIC_RELAXED);}
+
+#define AOE_RECENT_JUMP_BITS 12
+/* The shared entries are immutable after insertion. The per-thread index
+ * only points to entries already accepted by the full relocator. */
+static __thread const struct aoe_cache_entry *aoe_recent_jumps[1u << AOE_RECENT_JUMP_BITS];
+
+static BOOL aoe_cache_matches_jump(const struct aoe_cache_entry *entry, const BYTE *bytes,
+                                   unsigned prefix, uint64_t target)
+{
+    const struct aoe_fragment_key *key = &entry->key;
+
+    return key->count == 1 && key->len == prefix + 4 && key->offsets[0] == prefix &&
+           key->ends[0] == key->len && key->targets[0] == target &&
+           !memcmp(key->code, bytes, prefix);
+}
+
+static uint64_t aoe_cache_redirect(uint64_t pc, const struct aoe_cache_entry *entry)
+{
+    uint64_t target = (uint64_t)(aoe_cache_code + entry->slot * 64);
+
+    aoe_cache_thread_original = pc;
+    aoe_cache_thread_shadow = target;
+    aoe_cache_thread_len = entry->key.len;
+    aoe_cache_count(1);
+    return target;
+}
+
+static uint64_t aoe_cache_logical_pc(uint64_t pc)
+{
+ if(aoe_game_verified && aoe_cache_thread_shadow && pc>=aoe_cache_thread_shadow && pc<aoe_cache_thread_shadow+aoe_cache_thread_len){aoe_cache_count(7);return aoe_cache_thread_original+(pc-aoe_cache_thread_shadow);}return pc;
+}
+static void aoe_cache_init(void)
+{
+ SIZE_T size=AOE_CACHE_COUNT*64;void *addr=(void*)0x190000000ULL;const char *directory=getenv("AOELAB_COUNTERS_DIR");
+ aoe_cache_attempted=1;
+ if(NtAllocateVirtualMemory(GetCurrentProcess(),&addr,0,&size,MEM_RESERVE|MEM_COMMIT,PAGE_EXECUTE_READWRITE))return;
+ aoe_cache_entries=calloc(AOE_CACHE_TABLE,sizeof(*aoe_cache_entries));if(!aoe_cache_entries){size=0;NtFreeVirtualMemory(GetCurrentProcess(),&addr,&size,MEM_RELEASE);return;}aoe_cache_code=addr;
+ if(directory&&directory[0]=='/'){
+  mkdir(directory,0700);
+  char path[1024];int fd;void *map;
+  if(snprintf(path,sizeof(path),"%s/codecache-%u.bin",directory,(unsigned)getpid())<(int)sizeof(path) && (fd=open(path,O_RDWR|O_CREAT|O_EXCL|O_NOFOLLOW,0600))>=0){
+   if(!ftruncate(fd,4096)&&(map=mmap(NULL,4096,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0))!=MAP_FAILED){uint64_t *p=map;p[0]=0x414f454341434831ULL;p[1]=1;p[2]=getpid();p[3]=16;__atomic_store_n(&aoe_cache_stats,p+4,__ATOMIC_RELAXED);}close(fd);
+  }
+ }
+}
+/* Calibration only: report candidates without ever redirecting execution. A pointer
+ * near a resumed PC is evidence to investigate, not proof of the ring contract. */
+static void aoe_cache_candidates(uint64_t pc)
+{
+ static unsigned scans;
+ static time_t last;
+ time_t now, previous;
+ uint64_t address;
+ unsigned reported=0;
+ if (!aoe_game_verified || aoe_cache_pointer_address || !getenv("AOE4_CACHE_DIAGNOSTICS") ||
+     !aoe_cache_search_start || aoe_cache_search_end<aoe_cache_search_start ||
+     aoe_cache_search_end-aoe_cache_search_start>0x4000000 ||
+     pc<0x140000000ULL || pc>=0x180000000ULL) return;
+ now=time(NULL);
+ previous=__atomic_exchange_n(&last,now,__ATOMIC_RELAXED);
+ if (previous==now || __atomic_fetch_add(&scans,1,__ATOMIC_RELAXED)>=64) return;
+ for (address=aoe_cache_search_start; address<aoe_cache_search_end; address+=4096)
+ {
+  uint64_t values[512];
+  SIZE_T bytes=aoe_cache_search_end-address<sizeof(values)?aoe_cache_search_end-address:sizeof(values);
+  unsigned i;
+  if (virtual_uninterrupted_read_memory((void*)(uintptr_t)address,values,bytes)!=bytes) continue;
+  for (i=0; i<bytes/8; ++i)
+  {
+   uint64_t ring=values[i];
+   if (ring && !(ring&31) && ring<=pc && pc-ring<0x1000000 && ++reported<=16)
+    fprintf(stderr,"AoE4 cache candidate ONLY: pointer_rva=0x%llx ring=0x%llx resumed_pc=0x%llx; validate before profiling\n",
+            (unsigned long long)(address+i*8-0x140000000ULL),(unsigned long long)ring,(unsigned long long)pc);
+  }
+ }
+ if (!reported) fprintf(stderr,"AoE4 cache diagnostics: no candidate for resumed PC 0x%llx\n",(unsigned long long)pc);
+
+}
+
+static int aoe_live_ring_matches(uint64_t ring)
+{
+ const uint64_t end=ring+0x1000000;
+ uint64_t address=ring;
+
+ while (address<end)
+ {
+  MEMORY_BASIC_INFORMATION info;
+  uint64_t base;
+  if (NtQueryVirtualMemory(GetCurrentProcess(),(void *)(uintptr_t)address,
+                          MemoryBasicInformation,&info,sizeof(info),NULL) ||
+      info.State!=MEM_COMMIT || info.Type!=MEM_PRIVATE || (uintptr_t)info.AllocationBase!=ring ||
+      (info.Protect!=PAGE_EXECUTE_READ && info.Protect!=PAGE_EXECUTE_READWRITE &&
+       info.Protect!=PAGE_EXECUTE_WRITECOPY)) return 0;
+  base=(uintptr_t)info.BaseAddress;
+  if (base>address || info.RegionSize<=address-base || info.RegionSize>UINT64_MAX-base) return 0;
+  address=base+info.RegionSize;
+ }
+ return 1;
+}
+
+static int aoe_auto_ring_ready(uint64_t ring)
+{
+ static uint64_t accepted, rejected;
+ if (__atomic_load_n(&accepted,__ATOMIC_RELAXED)==ring) return 1;
+ if (__atomic_load_n(&rejected,__ATOMIC_RELAXED)==ring) return 0;
+ if (!aoe_live_ring_matches(ring))
+ {
+  if (__atomic_exchange_n(&rejected,ring,__ATOMIC_RELAXED)!=ring)
+   fprintf(stderr,"AoE4 cache: discovered ring allocation failed validation at %#llx\n",(unsigned long long)ring);
+  return 0;
+ }
+ if (__atomic_exchange_n(&accepted,ring,__ATOMIC_RELAXED)!=ring)
+  fprintf(stderr,"AoE4 cache: discovered ring allocation accepted at %#llx\n",(unsigned long long)ring);
+ return 1;
+}
+
+static uint64_t aoe_cache_target(uint64_t pc)
+{
+ UINT_PTR ring=0;
+ uint64_t hash=1469598103934665603ULL,jump_target=0,jump_hash;
+ BYTE original[32],emitted[40],*jump;
+ struct aoe_fragment_key key;
+ const struct aoe_cache_entry *entry=NULL,*recent;
+ unsigned available,i,index,prefix=0,jump_index=0;
+ int32_t displacement;
+ if(!aoe_game_verified)return pc;
+ if(!aoe_game_verified)return pc;
+ if(!aoe_cache_pointer_address){aoe_cache_candidates(pc);return pc;}
+ pthread_once(&aoe_cache_enable_once,aoe_cache_check_enabled);
+ if(!aoe_cache_enabled || pc<0x140000000ULL || pc>=0x180000000ULL)return pc;
+ available=virtual_read_aoe_fragment((const void*)(uintptr_t)aoe_cache_pointer_address,pc,&ring,original);
+ if(!available)return pc;
+ if(aoe_cache_auto_discovered && ((ring&0xfff) || !aoe_auto_ring_ready(ring)))return pc;
+ /* Most generated slots end in a near jump. Look up the instruction
+  * bytes and absolute destination so the ring's changing PC can be reused. */
+ if(available>=5 && (jump=memchr(original,0xe9,available-4)))
+ {
+    prefix=jump-original+1;
+    memcpy(&displacement,jump+1,sizeof(displacement));
+    jump_target=pc+prefix+4+displacement;
+    if(jump_target>=pc && jump_target-pc<available)prefix=0;
+    else
+    {
+        jump_hash=jump_target;
+        for(i=0;i<prefix;i++)jump_hash=(jump_hash^original[i])*1099511628211ULL;
+        jump_index=jump_hash>>(64-AOE_RECENT_JUMP_BITS);
+        recent=__atomic_load_n(&aoe_recent_jumps[jump_index],__ATOMIC_RELAXED);
+        if(recent && aoe_cache_matches_jump(recent,original,prefix,jump_target))
+        {
+            aoe_cache_count(0);
+            aoe_cache_count(2);
+            aoe_cache_count(5);
+            return aoe_cache_redirect(pc,recent);
+        }
+    }
+ }
+ if(!aoe_fragment_key(original,available,pc,&key)){aoe_cache_count(4);pthread_mutex_lock(&aoe_cache_lock);aoe_cache_dump_unkeyable(pc,original,available);pthread_mutex_unlock(&aoe_cache_lock);return pc;}
+ for(i=0;i<sizeof(key);i++){hash^=((BYTE*)&key)[i];hash*=1099511628211ULL;}if(!hash)hash=1;
+ pthread_mutex_lock(&aoe_cache_lock);
+ if(!aoe_cache_attempted)aoe_cache_init();aoe_cache_count(0);
+ if(!aoe_cache_code)goto done;
+ index=hash&(AOE_CACHE_TABLE-1);
+ for(i=0;i<64;i++,index=(index+1)&(AOE_CACHE_TABLE-1)){
+  struct aoe_cache_entry *e=&aoe_cache_entries[index];
+  if(e->hash==hash&&!memcmp(&e->key,&key,sizeof(key))){aoe_cache_count(2);entry=e;break;}
+  if(!e->hash){
+   BYTE *target;if(aoe_cache_used==AOE_CACHE_COUNT){aoe_cache_count(6);break;}target=aoe_cache_code+aoe_cache_used*64;
+   if(!aoe_fragment_emit(&key,(uint64_t)target,emitted)){aoe_cache_count(6);break;}
+   memcpy(target,emitted,40);e->key=key;e->slot=aoe_cache_used++;e->hash=hash;aoe_cache_count(3);__atomic_store_n(&aoe_cache_stats[8],aoe_cache_used,__ATOMIC_RELAXED);entry=e;break;
+  }
+ }
+ if(i==64)aoe_cache_count(6);
+done:
+ pthread_mutex_unlock(&aoe_cache_lock);
+ if(!entry)return pc;
+ if(prefix && aoe_cache_matches_jump(entry,original,prefix,jump_target))
+    __atomic_store_n(&aoe_recent_jumps[jump_index],entry,__ATOMIC_RELAXED);
+ return aoe_cache_redirect(pc,entry);
+}

+/* AoE IV build eligibility for the experimental Highball engine proposal.
+ * Copyright 2026 Highball engine proposal contributors.
+ * LGPL-2.1-or-later. Hash the same file descriptor Wine will map, not a reopened path. */
+#ifndef HIGHBALL_AOE_BUILD_GUARD_H
+#define HIGHBALL_AOE_BUILD_GUARD_H
+#include <CommonCrypto/CommonDigest.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+static const unsigned char aoe_supported_sha256[32] = {
+    0x53,0x80,0xc5,0x77,0x80,0x55,0x65,0x81,0x7f,0x52,0x8a,0xf6,0xea,0xc3,0x85,0x26,
+    0x34,0x13,0xfa,0x68,0x15,0x55,0x3f,0x9a,0x31,0xfa,0x62,0x56,0x1c,0xb4,0x5e,0x8c
+};
+
+static int aoe_game_name(const char *path)
+{
+    const char *p, *name = path;
+    if (!path) return 0;
+    for (p = path; *p; p++) if (*p == '/' || *p == '\\') name = p + 1;
+    return !strcasecmp(name, "RelicCardinal.exe");
+}
+
+static int aoe_bootstrap_is_current(const char *name)
+{
+    char expected[64];
+    snprintf(expected, sizeof(expected), "x87sidecar.%ld", (long)getpid());
+    return name && !strcmp(name, expected);
+}
+
+/* Only the recipe's explicit opt-in can activate the Rosetta hooks. */
+static int aoe_patch_requested(void)
+{
+    const char *enabled = getenv("HB_AOE4");
+    const char *disabled = getenv("AOE4_DISABLED");
+    return enabled && !strcmp(enabled, "1") && (!disabled || strcmp(disabled, "1"));
+}
+
+static int aoe_same_file_state(const struct stat *first, const struct stat *second)
+{
+    struct stat before=*first, after=*second;
+    if (before.st_dev != after.st_dev || before.st_ino != after.st_ino ||
+        before.st_size != after.st_size || before.st_mtime != after.st_mtime ||
+        before.st_ctime != after.st_ctime) return 0;
+#ifdef __APPLE__
+    if (before.st_mtimespec.tv_nsec != after.st_mtimespec.tv_nsec ||
+        before.st_ctimespec.tv_nsec != after.st_ctimespec.tv_nsec) return 0;
+#else
+    if (before.st_mtim.tv_nsec != after.st_mtim.tv_nsec ||
+        before.st_ctim.tv_nsec != after.st_ctim.tv_nsec) return 0;
+#endif
+    return 1;
+}
+
+static int aoe_hash_fd(int fd, unsigned char digest[32])
+{
+    unsigned char buffer[65536];
+    struct stat before, after;
+    CC_SHA256_CTX context;
+    off_t offset = 0;
+    ssize_t count;
+
+    if (fstat(fd, &before) || !S_ISREG(before.st_mode) || before.st_size <= 0) return 0;
+    if (!CC_SHA256_Init(&context)) return 0;
+    for (;;)
+    {
+        count = pread(fd, buffer, sizeof(buffer), offset);
+        if (count < 0 && errno == EINTR) continue;
+        if (count < 0) return 0;
+        if (!count) break;
+        if (!CC_SHA256_Update(&context, buffer, (CC_LONG)count)) return 0;
+        offset += count;
+    }
+    if (offset != before.st_size || fstat(fd, &after)) return 0;
+    if (!aoe_same_file_state(&before,&after)) return 0;
+    return CC_SHA256_Final(digest, &context);
+}
+
+static int aoe_hash_fd_matches(int fd, const unsigned char expected[32])
+{
+    unsigned char digest[32];
+    return aoe_hash_fd(fd, digest) && !memcmp(digest, expected, 32);
+}
+
+/* Independent LGPL implementation; no MacGames application code is incorporated. */
+struct aoe_image_layout
+{
+    uint64_t base, image_size, text_start, text_end, data_start, data_end;
+    uint32_t text_offset, text_file_size;
+};
+static uint32_t aoe_u32(const unsigned char *p)
+{ return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24; }
+static unsigned aoe_u16(const unsigned char *p) { return p[0] | p[1]<<8; }
+static int aoe_read_layout(int fd, struct aoe_image_layout *layout)
+{
+    unsigned char bytes[65536];
+    ssize_t n = pread(fd, bytes, sizeof(bytes), 0);
+    size_t pe, opt, table, i;
+    unsigned count, optional_size, found = 0;
+    uint64_t text_size, rva;
+    memset(layout,0,sizeof(*layout));
+    if (n < 64 || bytes[0]!='M' || bytes[1]!='Z') return 0;
+    pe = aoe_u32(bytes+60);
+    if (pe > (size_t)n-24 || memcmp(bytes+pe,"PE\0\0",4) || aoe_u16(bytes+pe+4)!=0x8664) return 0;
+    count = aoe_u16(bytes+pe+6); optional_size = aoe_u16(bytes+pe+20);
+    opt = pe+24;
+    if (optional_size<112 || opt+optional_size>(size_t)n || aoe_u16(bytes+opt)!=0x20b) return 0;
+    layout->base = aoe_u32(bytes+opt+24) | (uint64_t)aoe_u32(bytes+opt+28)<<32;
+    layout->image_size = aoe_u32(bytes+opt+56);
+    if (layout->base!=0x140000000ULL || layout->image_size>0x40000000 || !layout->image_size) return 0;
+    table = opt+optional_size;
+    if (!count || count>96 || table+(size_t)count*40>(size_t)n) return 0;
+    for (i=0; i<count; ++i)
+    {
+        const unsigned char *section = bytes+table+i*40;
+        if (!memcmp(section,".data\0\0\0",8))
+        {
+            uint64_t data_rva=aoe_u32(section+12), data_size=aoe_u32(section+8);
+            if (layout->data_start || !(aoe_u32(section+36)&0x80000000) ||
+                !data_size || data_rva+data_size>layout->image_size) return 0;
+            layout->data_start=layout->base+data_rva;
+            layout->data_end=layout->data_start+data_size;
+        }
+        if (memcmp(section,".text\0\0\0",8)) continue;
+        if (found++) return 0;
+        text_size = aoe_u32(section+8); rva = aoe_u32(section+12);
+        if (!(aoe_u32(section+36)&0x20000000) || rva!=0x1000 || text_size<=0x500 ||
+            text_size>0x8000000 || rva+text_size>layout->image_size) return 0;
+        layout->text_start = layout->base+rva;
+        layout->text_end = layout->text_start+text_size-0x500;
+        layout->text_offset = aoe_u32(section+20);
+        layout->text_file_size = aoe_u32(section+16);
+        if (layout->text_file_size > text_size-0x500) layout->text_file_size = text_size-0x500;
+    }
+    return found==1;
+}
+static void aoe_digest_hex(const unsigned char digest[32], char text[65])
+{
+    unsigned i;
+    for (i=0; i<32; ++i) snprintf(text+2*i,3,"%02x",digest[i]);
+}
+
+/* Measured profiles for the 16 MiB / 32-byte ring, bound to executable SHA-256. */
+static int aoe_cache_profile(const char *digest, const struct aoe_image_layout *image,
+                            uint64_t *pointer)
+{
+    static const struct { const char *digest; uint64_t rva; } profiles[] =
+    {
+        { "5380c577805565817f528af6eac385263413fa6815553f9a31fa62561cb45e8c", 0x7af7ad0 },
+        { "e047891780ec9a01e39185803288578b8385419e93c97b2216ebd24ee2bc1469", 0x7c9f9d8 },
+    };
+    unsigned int i;
+    uint64_t rva;
+    for (i=0; i<sizeof(profiles)/sizeof(profiles[0]); ++i)
+    {
+        if (strcmp(profiles[i].digest,digest)) continue;
+        rva=profiles[i].rva;
+        if (rva<0x1000 || (rva&7) || image->image_size<8 || rva>image->image_size-8 ||
+            image->base+rva<image->data_start || image->data_end<8 ||
+            image->base+rva>image->data_end-8) return 0;
+        *pointer=image->base+rva;
+        return 1;
+    }
+    return 0;
+}
+#endif

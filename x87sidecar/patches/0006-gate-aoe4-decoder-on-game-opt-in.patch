x87sidecar: select AoE decoding only on an opted-in Wine launch

Kind: Highball integration. License: MIT (upstream LICENSE).
Wine supplies the decoder addresses after checking the game image.

--- a/rosetta_loader/src/stub_asm.cpp
+++ b/rosetta_loader/src/stub_asm.cpp
@@ -1387,7 +1387,8 @@
                          const uint8_t origPrologue16[16], uint16_t hostArplOpcode) {
     const char* softTarget = std::getenv("AOE_SOFTFAULT_TARGET");
     const char* softPC = std::getenv("AOE_SOFTFAULT_PC");
-    if (!softTarget && !softPC) {
+    const char* enabled = std::getenv("HB_AOE4");
+    if (!enabled || std::strcmp(enabled, "1") || (!softTarget && !softPC)) {
         return buildGenericDecodeHook(handlerAddr, decodeOpcodeAddr, origPrologue16, hostArplOpcode);
     }
     if (!softTarget || !softPC) return {};

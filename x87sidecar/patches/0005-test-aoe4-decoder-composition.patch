From f02887422ec3a671718261e1a31cb0e1c232bbbe Mon Sep 17 00:00:00 2001
From: Luis Riegger <lri@me.com>
Date: Tue, 17 Nov 2026 16:14:52 +0100
Subject: [PATCH] Test AoE software-fault composition on upstream Rosetta hooks


Kind: regression tests
License: MIT (see upstream LICENSE)
---
 scripts/test_aoe_softfault.py | 30 +++++++++++++++++++++++++++++
 tests/CMakeLists.txt          |  3 +++
 tests/test_aoe_softfault.c    | 36 +++++++++++++++++++++++++++++++++++
 3 files changed, 69 insertions(+)
 create mode 100644 scripts/test_aoe_softfault.py
 create mode 100644 tests/test_aoe_softfault.c

diff --git a/scripts/test_aoe_softfault.py b/scripts/test_aoe_softfault.py
new file mode 100644
index 0000000..2dc3cb2
--- /dev/null
+++ b/scripts/test_aoe_softfault.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MIT
+"""Exercise the AoE decoder through cooperative attach on the installed Rosetta."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+build = Path(sys.argv[1] if len(sys.argv) > 1 else 'build').resolve()
+helper = build / 'bin/x87sidecar'
+fixture = build / 'bin/tests/test_aoe_softfault'
+symbols = {}
+for line in subprocess.check_output(['nm', '-g', str(fixture)], text=True).splitlines():
+    fields = line.split()
+    if len(fields) == 3:
+        symbols[fields[2]] = int(fields[0], 16)
+env = dict(os.environ,
+    AOE_SOFTFAULT_PC=hex(symbols['_aoe_softfault_begin']),
+    AOE_SOFTFAULT_END=hex(symbols['_aoe_softfault_end']),
+    AOE_SOFTFAULT_TARGET=hex(symbols['_aoe_softfault_handler']),
+    AOE_SOFTFAULT_TARGET1=hex(symbols['_aoe_softfault_handler']),
+    X87_STRICT_ALLOC='1')
+subprocess.run([str(helper), '--cooperative', str(fixture)], env=env, check=True, timeout=30)
+# The composed hook must also retain the generic decoder's aliases.
+for name in ('test_decoder_fcomp_st', 'test_decoder_arpl'):
+    # An unused range enables composition without matching these test executables.
+    outside = dict(env, AOE_SOFTFAULT_PC='0x10000', AOE_SOFTFAULT_END='0x10010',
+                   AOE_SOFTFAULT_TARGET='0x20000', AOE_SOFTFAULT_TARGET1='0x20010')
+    subprocess.run([str(helper), '--cooperative', str(build / 'bin/tests' / name)],
+                   env=outside, check=True, timeout=30)
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 94869f2..0adff8c 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -135,3 +135,6 @@ target_include_directories(test_opcode_table_parse PRIVATE ${PROJECT_SOURCE_DIR}
 add_executable(test_fragment_root host/test_fragment_root.cpp
     ${PROJECT_SOURCE_DIR}/rosetta_loader/src/fragment_root.cpp)
 target_include_directories(test_fragment_root PRIVATE ${PROJECT_SOURCE_DIR}/rosetta_loader/src)
+
+# Fixed guest addresses let the AoE decoder fixture specify its bounded text range.
+_add_x86_sample_impl(test_aoe_softfault "-Wl,-no_pie")
diff --git a/tests/test_aoe_softfault.c b/tests/test_aoe_softfault.c
new file mode 100644
index 0000000..8fc515a
--- /dev/null
+++ b/tests/test_aoe_softfault.c
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: MIT
+ * Run with scripts/test_aoe_softfault.py: these bytes are invalid in 64-bit mode. */
+#include <stdio.h>
+
+volatile unsigned aoe_softfault_calls;
+__attribute__((noinline)) void aoe_softfault_handler(void) { ++aoe_softfault_calls; }
+extern void aoe_softfault_pair(void);
+extern void aoe_softfault_single(void);
+
+__asm__(".text\n"
+        ".globl _aoe_softfault_begin\n"
+        "_aoe_softfault_begin:\n"
+        ".globl _aoe_softfault_pair\n"
+        "_aoe_softfault_pair:\n"
+        ".byte 0xd5, 0x7f\n" /* AAD: two-byte lowering. */
+        "ret\n"
+        ".globl _aoe_softfault_single\n"
+        "_aoe_softfault_single:\n"
+        ".byte 0x1e\n"       /* PUSH DS: one-byte lowering. */
+        "ret\n"
+        ".globl _aoe_softfault_end\n"
+        "_aoe_softfault_end:\n");
+
+int main(void)
+{
+    double sum;
+    aoe_softfault_pair();
+    aoe_softfault_single();
+    __asm__ volatile("fld1; fld1; faddp; fstpl %0" : "=m"(sum) : : "st");
+    if (aoe_softfault_calls != 2 || sum != 2.0) {
+        printf("FAIL AoE decoder: calls=%u, sum=%g\n", aoe_softfault_calls, sum);
+        return 1;
+    }
+    puts("PASS AoE one/two-byte software faults and x87 composition");
+    return 0;
+}

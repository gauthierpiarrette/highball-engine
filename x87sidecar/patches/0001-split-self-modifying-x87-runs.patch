+            PASSED=$((PASSED + 1))
+        else
+            echo -e "${RED}FAIL${NC}  test_x87_smc  (SMC_NO_WARMUP=1: wanted one stale first iteration in each of 6 cases, got $STALE, $OTHER other failures, exit=$EXIT)"

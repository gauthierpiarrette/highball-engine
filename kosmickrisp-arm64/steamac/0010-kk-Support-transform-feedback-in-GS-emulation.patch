+/* Copy buffer offsets; use zero when the source is NULL. */
+KERNEL(1)
+libkk_copy_xfb_counters(constant struct libkk_xfb_counter_copy *copy)
+{
+   uint i = cl_global_id.x;
+   *(copy->dest[i]) = copy->src[i] ? *(copy->src[i]) : 0;

From: steamac <steamac@fxgam.es>
Subject: [PATCH] kk: reject unrepresentable texel buffer views before Metal

STEAMAC-3S/3Z/3J/3F/4B/3K/3G/3R: VK_WHOLE_SIZE over large buffers
reaches both texture-buffer constructors with widths above Metal's 2^28
limit; a remaining range shorter than one texel instead creates width zero.
Return an allocation error without invoking Metal validation.

Advertise a limit that also fits RGB32 expansion and sparse alignment
prefixes, rather than silently truncating valid RGB32 views. Round the
backing row length down to complete texels as VK_WHOLE_SIZE requires.

--- a/src/kosmickrisp/vulkan/kk_buffer_view.c
+++ b/src/kosmickrisp/vulkan/kk_buffer_view.c
@@ -124,6 +124,19 @@
       kk_buffer_view_warn_unsupported(view->vk.format, buffer->sparse);
       *pBufferView = kk_buffer_view_to_handle(view);
       return VK_SUCCESS;
+   }
+
+   /* VK_WHOLE_SIZE rounds down to complete texels; it can produce zero
+    * elements. The guest may also exceed maxTexelBufferElements (including
+    * with VK_WHOLE_SIZE, VUID 04059). Neither case is a Metal descriptor:
+    * fail here, before narrowing the width or calling either texture API.
+    */
+   if (view->vk.elements == 0 ||
+       view->vk.elements > KK_MAX_TEXEL_BUFFER_ELEMENTS) {
+      vk_buffer_view_destroy(&dev->vk, pAllocator, &view->vk);
+      return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "Texel buffer view has zero elements or exceeds "
+                       "maxTexelBufferElements");
    }
 
    enum mtl_texture_usage usage = MTL_TEXTURE_USAGE_SHADER_READ;
@@ -156,13 +169,11 @@
       texture_offset = mtl_offset;
    }
    view->texel_offset = (mtl_offset - texture_offset) / texel_B;
-   uint64_t width_px = view->vk.elements + view->texel_offset;
-   if (rgb32) {
-      /* Texels past maxTexelBufferElements read as out of bounds */
-      width_px = MIN2(view->vk.elements * 3u + view->texel_offset,
-                      KK_MAX_TEXEL_BUFFER_ELEMENTS);
+   const uint64_t width_px =
+      view->vk.elements * (rgb32 ? 3ull : 1ull) + view->texel_offset;
+   assert(width_px <= KK_MTL_MAX_TEXEL_BUFFER_ELEMENTS);
+   if (rgb32)
       view->texel_offset |= KK_TEXEL_BUFFER_RGB32;
-   }
 
    struct kk_image_layout layout = {
       .width_px = width_px,
@@ -183,7 +194,7 @@
             .blue = supported_format->unswizzle.blue,
             .alpha = supported_format->unswizzle.alpha,
          },
-      .linear_stride_B = view->vk.range + (mtl_offset - texture_offset),
+      .linear_stride_B = width_px * texel_B,
    };
    if (buffer->sparse) {
       VkResult result = kk_buffer_view_sparse_init(
--- a/src/kosmickrisp/vulkan/kk_private.h
+++ b/src/kosmickrisp/vulkan/kk_private.h
@@ -22,7 +22,11 @@
 #define KK_MAX_SAMPLES                   8
 #define KK_MIN_SSBO_ALIGNMENT            16
 #define KK_MIN_TEXEL_BUFFER_ALIGNMENT    16
-#define KK_MAX_TEXEL_BUFFER_ELEMENTS     (16384u * 16384u)
+/* Metal texture buffers have at most 2^28 texels. Reserve an alignment
+ * prefix (a sparse page) and three R32 texels per RGB32 Vulkan element. */
+#define KK_MTL_MAX_TEXEL_BUFFER_ELEMENTS (1u << 28)
+#define KK_MAX_TEXEL_BUFFER_ELEMENTS                                            \
+   ((KK_MTL_MAX_TEXEL_BUFFER_ELEMENTS - KK_SPARSE_PAGE_SIZE_B) / 3u)
 #define KK_MIN_UBO_ALIGNMENT             64
 #define KK_MAX_VIEWPORTS                 16
 #define KK_MAX_DESCRIPTOR_SIZE           64

@@ -0,0 +1,52 @@
+/*
+ * Copyright 2026 TxCsOffc
+ * SPDX-License-Identifier: MIT
+ *
+ * The same interface as vkd3d-proton's include/private/vkd3d_hb_metalfx.h (Highball's renderers).
+ */
+
+#ifndef KK_HB_METALFX_H
+#define KK_HB_METALFX_H
+
+#include <vulkan/vulkan_core.h>
+
+/* Highball's MetalFX temporal scale. A driver that lists the word "hb-metalfx" in
+ * VkPhysicalDeviceDriverProperties::driverInfo (KosmicKrisp with Highball's patch) runs it when it finds this
+ * structure in the pNext chain of vkCmdPipelineBarrier2's VkDependencyInfo, in command buffer order, after the
+ * barrier. Wine's Vulkan layer passes that pNext chain to the driver as it is. */
+
+#define VK_STRUCTURE_TYPE_HB_METALFX_SCALE_INFO ((VkStructureType)1000999200)
+#define VKD3D_HB_METALFX_DRIVER_WORD "hb-metalfx"
+
+enum vkd3d_hb_metalfx_image
+{
+    VKD3D_HB_METALFX_IMAGE_COLOR = 0,
+    VKD3D_HB_METALFX_IMAGE_DEPTH,
+    VKD3D_HB_METALFX_IMAGE_MOTION,
+    VKD3D_HB_METALFX_IMAGE_OUTPUT,
+    VKD3D_HB_METALFX_IMAGE_REACTIVE,
+    VKD3D_HB_METALFX_IMAGE_COUNT,
+};
+
+#define VKD3D_HB_METALFX_RESET              0x1u /* drop the scaler's history */
+#define VKD3D_HB_METALFX_DEPTH_REVERSED     0x2u /* depth 1 is near */
+#define VKD3D_HB_METALFX_AUTO_EXPOSURE      0x4u /* the scaler computes exposure itself */
+#define VKD3D_HB_METALFX_MOTION_DISPLAY_RES 0x8u /* motion vectors are at the output size */
+
+typedef struct VkHbMetalFXScaleInfo
+{
+    VkStructureType sType;
+    const void *pNext;
+    uint32_t scalerId;         /* the driver keeps one scaler per id and size */
+    uint32_t flags;            /* VKD3D_HB_METALFX_* */
+    VkImage images[VKD3D_HB_METALFX_IMAGE_COUNT]; /* color, depth, motion and output are required */
+    uint32_t inputContentWidth;  /* the rendered region of color, depth and motion, from their origin */
+    uint32_t inputContentHeight;
+    float motionVectorScaleX;    /* to pixels at the motion vectors' size */
+    float motionVectorScaleY;
+    float jitterOffsetX;         /* in pixels */
+    float jitterOffsetY;
+    float preExposure;
+} VkHbMetalFXScaleInfo;
+
+#endif /* KK_HB_METALFX_H */

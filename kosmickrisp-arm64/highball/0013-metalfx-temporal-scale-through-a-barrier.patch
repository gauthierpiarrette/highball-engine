 }
 
+static void
+kk_hb_metalfx_scale(struct kk_cmd_buffer *cmd, const VkHbMetalFXScaleInfo *info)
+{
+   static const unsigned bridge_index[VKD3D_HB_METALFX_IMAGE_COUNT] = {
+      [VKD3D_HB_METALFX_IMAGE_COLOR] = MTL_METALFX_COLOR,
+      [VKD3D_HB_METALFX_IMAGE_DEPTH] = MTL_METALFX_DEPTH,
+      [VKD3D_HB_METALFX_IMAGE_MOTION] = MTL_METALFX_MOTION,
+      [VKD3D_HB_METALFX_IMAGE_OUTPUT] = MTL_METALFX_OUTPUT,
+      [VKD3D_HB_METALFX_IMAGE_REACTIVE] = MTL_METALFX_REACTIVE,
+   };
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct mtl_metalfx_scale s = {
+      .scaler_id = info->scalerId,
+      .type = MTL_METALFX_TEMPORAL,
+      .auto_exposure = info->flags & VKD3D_HB_METALFX_AUTO_EXPOSURE,
+      .reset = info->flags & VKD3D_HB_METALFX_RESET,
+      .depth_reversed = info->flags & VKD3D_HB_METALFX_DEPTH_REVERSED,
+      .motion_display_res = info->flags & VKD3D_HB_METALFX_MOTION_DISPLAY_RES,
+      .input_content_width = info->inputContentWidth,
+      .input_content_height = info->inputContentHeight,
+      .motion_scale_x = info->motionVectorScaleX,
+      .motion_scale_y = info->motionVectorScaleY,
+      .jitter_x = info->jitterOffsetX,
+      .jitter_y = info->jitterOffsetY,
+      .pre_exposure = info->preExposure,
+   };
+   for (uint32_t i = 0; i < VKD3D_HB_METALFX_IMAGE_COUNT; i++) {
+      VK_FROM_HANDLE(kk_image, image, info->images[i]);
+      if (image)
+         s.textures[bridge_index[i]] = image->planes[0].mtl_handle;
+   }
+
+   if (cmd->metal.render) {
+      kk_apply_attachment_store_ops(cmd, true);
+      cs_end(cmd);
+      kk_cmd_buffer_dirty_all_gfx(cmd);
+      cmd->state.gfx.need_to_start_render_pass = true;
+   }
+   cs_end(cmd);
+
+   if (mtl_metalfx_encode(dev->hb_metalfx, dev->mtl_handle, dev->mtl_compiler_handle,
+                          cmd->metal.cmd_buf, &s)) {
+      cmd->metal.cmd_buf_used = true;
+      cmd->hb_metalfx_wait = true;
+   }
+}

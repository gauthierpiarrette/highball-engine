+uint64_t
+kk_image_layout_host_subresource(const struct kk_image_layout *layout,
+                                 uint32_t level, uint32_t layer,
+                                 VkSubresourceLayout *out)
+{
+   uint64_t offset_B = 0;
+   for (uint32_t l = 0; l < layout->levels; l++) {
+      const uint32_t depth_px = u_minify(layout->depth_px, l);
+      const uint64_t row_B =
+         util_format_get_stride(layout->format.pipe, u_minify(layout->width_px, l));
+      const uint64_t slice_B =
+         row_B * util_format_get_nblocksy(layout->format.pipe,
+                                          u_minify(layout->height_px, l));
+      const uint64_t layer_B = slice_B * depth_px;
+      if (out && l == level) {
+         *out = (VkSubresourceLayout){
+            .offset = offset_B + layer_B * layer,
+            .size = layer_B,
+            .rowPitch = row_B,
+            .arrayPitch = layer_B,
+            .depthPitch = slice_B,
+         };
+      }
+      offset_B += layer_B * layout->layers;
+   }
+   return offset_B;
 }

diff --git a/src/kosmickrisp/bridge/mtl_upscaler.h b/src/kosmickrisp/bridge/mtl_upscaler.h
new file mode 100644
index 0000000000000000000000000000000000000000..576dc049481d9fd1159375001a0be0e3459aebd8
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_upscaler.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright 2026 Highball
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef MTL_UPSCALER_H
+#define MTL_UPSCALER_H 1
+
+#include "mtl_types.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef void mtl_upscaler;
+
+struct mtl_upscale {
+   mtl_texture *color;
+   mtl_texture *depth;
+   mtl_texture *motion;
+   mtl_texture *reactive;
+   mtl_texture *exposure;
+   mtl_texture *output;
+   uint32_t content_width;
+   uint32_t content_height;
+   float jitter_x;
+   float jitter_y;
+   float motion_scale_x;
+   float motion_scale_y;
+   float pre_exposure;
+   bool reset;
+   bool depth_reversed;
+   bool auto_exposure;
+   bool motion_at_output;
+};
+
+bool mtl_upscaler_supported(mtl_device *device);
+mtl_upscaler *mtl_new_upscaler(mtl_device *device, mtl_compiler *compiler,
+                               const struct mtl_upscale *upscale);
+bool mtl_upscaler_matches(mtl_upscaler *upscaler,
+                          const struct mtl_upscale *upscale);
+bool mtl_upscaler_content_fits(mtl_device *device, mtl_upscaler *upscaler,
+                               const struct mtl_upscale *upscale);
+void mtl_upscaler_encode(mtl_upscaler *upscaler,
+                         mtl_command_buffer *command_buffer,
+                         const struct mtl_upscale *upscale);
+
+#endif
diff --git a/src/kosmickrisp/bridge/mtl_upscaler.m b/src/kosmickrisp/bridge/mtl_upscaler.m
new file mode 100644
index 0000000000000000000000000000000000000000..cd147f8921e0d4381493487c66ae61812c128550
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_upscaler.m
@@ -0,0 +1,151 @@
+/*
+ * Copyright 2026 Highball
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "mtl_upscaler.h"
+
+#include <Metal/MTL4CommandBuffer.h>
+#include <Metal/MTL4Compiler.h>
+#include <MetalFX/MetalFX.h>
+
+#if defined(__MAC_27_0) && __MAC_OS_X_VERSION_MAX_ALLOWED >= __MAC_27_0
+#define MTL_UPSCALER_HAS_OUTPUT_MOTION 1
+#else
+#define MTL_UPSCALER_HAS_OUTPUT_MOTION 0
+#endif
+
+bool
+mtl_upscaler_supported(mtl_device *device)
+{
+   @autoreleasepool {
+      return [MTLFXTemporalScalerDescriptor supportsDevice:(id<MTLDevice>)device];
+   }
+}
+
+mtl_upscaler *
+mtl_new_upscaler(mtl_device *device, mtl_compiler *compiler,
+                 const struct mtl_upscale *upscale)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      id<MTLTexture> color = (id<MTLTexture>)upscale->color;
+      id<MTLTexture> depth = (id<MTLTexture>)upscale->depth;
+      id<MTLTexture> motion = (id<MTLTexture>)upscale->motion;
+      id<MTLTexture> reactive = (id<MTLTexture>)upscale->reactive;
+      id<MTLTexture> output = (id<MTLTexture>)upscale->output;
+
+      MTLFXTemporalScalerDescriptor *desc =
+         [[[MTLFXTemporalScalerDescriptor alloc] init] autorelease];
+      desc.colorTextureFormat = color.pixelFormat;
+      desc.depthTextureFormat = depth.pixelFormat;
+      desc.motionTextureFormat = motion.pixelFormat;
+      desc.outputTextureFormat = output.pixelFormat;
+      desc.inputWidth = color.width;
+      desc.inputHeight = color.height;
+      desc.outputWidth = output.width;
+      desc.outputHeight = output.height;
+      desc.autoExposureEnabled = upscale->auto_exposure;
+      desc.inputContentPropertiesEnabled = YES;
+      desc.inputContentMinScale =
+         [MTLFXTemporalScalerDescriptor supportedInputContentMinScaleForDevice:dev];
+      desc.inputContentMaxScale =
+         [MTLFXTemporalScalerDescriptor supportedInputContentMaxScaleForDevice:dev];
+      if (reactive) {
+         desc.reactiveMaskTextureEnabled = YES;
+         desc.reactiveMaskTextureFormat = reactive.pixelFormat;
+      }
+      if (upscale->motion_at_output) {
+#if MTL_UPSCALER_HAS_OUTPUT_MOTION
+         if (@available(macOS 27.0, *))
+            desc.outputResolutionMotionVectorsEnabled = YES;
+         else
+            return NULL;
+#else
+         return NULL;
+#endif
+      }
+
+      return [desc newTemporalScalerWithDevice:dev
+                                      compiler:(id<MTL4Compiler>)compiler];
+   }
+}
+
+bool
+mtl_upscaler_matches(mtl_upscaler *upscaler, const struct mtl_upscale *upscale)
+{
+   @autoreleasepool {
+      id<MTL4FXTemporalScaler> scaler = (id<MTL4FXTemporalScaler>)upscaler;
+      id<MTLTexture> color = (id<MTLTexture>)upscale->color;
+      id<MTLTexture> depth = (id<MTLTexture>)upscale->depth;
+      id<MTLTexture> motion = (id<MTLTexture>)upscale->motion;
+      id<MTLTexture> reactive = (id<MTLTexture>)upscale->reactive;
+      id<MTLTexture> output = (id<MTLTexture>)upscale->output;
+
+      if (scaler.inputWidth != color.width ||
+          scaler.inputHeight != color.height ||
+          scaler.outputWidth != output.width ||
+          scaler.outputHeight != output.height)
+         return false;
+      if (scaler.colorTextureFormat != color.pixelFormat ||
+          scaler.depthTextureFormat != depth.pixelFormat ||
+          scaler.motionTextureFormat != motion.pixelFormat ||
+          scaler.outputTextureFormat != output.pixelFormat)
+         return false;
+      return scaler.reactiveMaskTextureFormat ==
+             (reactive ? reactive.pixelFormat : MTLPixelFormatInvalid);
+   }
+}
+
+bool
+mtl_upscaler_content_fits(mtl_device *device, mtl_upscaler *upscaler,
+                          const struct mtl_upscale *upscale)
+{
+   @autoreleasepool {
+      id<MTL4FXTemporalScaler> scaler = (id<MTL4FXTemporalScaler>)upscaler;
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      id<MTLTexture> color = (id<MTLTexture>)upscale->color;
+      id<MTLTexture> output = (id<MTLTexture>)upscale->output;
+      if (!upscale->content_width || !upscale->content_height ||
+          upscale->content_width > color.width ||
+          upscale->content_height > color.height)
+         return false;
+
+      float min_scale = scaler ? scaler.inputContentMinScale :
+         [MTLFXTemporalScalerDescriptor supportedInputContentMinScaleForDevice:dev];
+      float max_scale = scaler ? scaler.inputContentMaxScale :
+         [MTLFXTemporalScalerDescriptor supportedInputContentMaxScaleForDevice:dev];
+      double scale_x = (double)output.width / upscale->content_width;
+      double scale_y = (double)output.height / upscale->content_height;
+      return scale_x >= min_scale && scale_x <= max_scale &&
+             scale_y >= min_scale && scale_y <= max_scale;
+   }
+}
+
+void
+mtl_upscaler_encode(mtl_upscaler *upscaler, mtl_command_buffer *command_buffer,
+                    const struct mtl_upscale *upscale)
+{
+   @autoreleasepool {
+      id<MTL4FXTemporalScaler> scaler = (id<MTL4FXTemporalScaler>)upscaler;
+
+      scaler.colorTexture = (id<MTLTexture>)upscale->color;
+      scaler.depthTexture = (id<MTLTexture>)upscale->depth;
+      scaler.motionTexture = (id<MTLTexture>)upscale->motion;
+      scaler.outputTexture = (id<MTLTexture>)upscale->output;
+      scaler.exposureTexture = (id<MTLTexture>)upscale->exposure;
+      if (upscale->reactive)
+         scaler.reactiveMaskTexture = (id<MTLTexture>)upscale->reactive;
+      scaler.inputContentWidth = upscale->content_width;
+      scaler.inputContentHeight = upscale->content_height;
+      scaler.jitterOffsetX = upscale->jitter_x;
+      scaler.jitterOffsetY = upscale->jitter_y;
+      scaler.motionVectorScaleX = upscale->motion_scale_x;
+      scaler.motionVectorScaleY = upscale->motion_scale_y;
+      scaler.preExposure = upscale->pre_exposure > 0.0f ? upscale->pre_exposure : 1.0f;
+      scaler.reset = upscale->reset;
+      scaler.depthReversed = upscale->depth_reversed;
+
+      [scaler encodeToCommandBuffer:(id<MTL4CommandBuffer>)command_buffer];
+   }
+}

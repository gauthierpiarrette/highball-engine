+#ifndef KK_HB_UPSCALE_H
+#define KK_HB_UPSCALE_H 1
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <vulkan/vulkan_core.h>
+
+#define VK_STRUCTURE_TYPE_HB_TEMPORAL_UPSCALE_INFO ((VkStructureType)1000999300)
+#define HB_TEMPORAL_UPSCALE_DRIVER_INFO            "hb-upscale"
+
+enum {
+   HB_TEMPORAL_UPSCALE_RESET_BIT = 1u << 0,
+   HB_TEMPORAL_UPSCALE_DEPTH_REVERSED_BIT = 1u << 1,
+   HB_TEMPORAL_UPSCALE_AUTO_EXPOSURE_BIT = 1u << 2,
+   HB_TEMPORAL_UPSCALE_MOTION_AT_OUTPUT_BIT = 1u << 3,
+};
+
+typedef struct VkHbTemporalUpscaleInfo {
+   VkStructureType sType;
+   const void *pNext;
+   uint64_t context;
+   uint32_t flags;
+   VkImage depth;
+   VkImage motion;
+   VkImage reactive;
+   VkImage exposure;
+   float jitterX;
+   float jitterY;
+   float motionScaleX;
+   float motionScaleY;
+   float preExposure;
+} VkHbTemporalUpscaleInfo;
+
+#define KK_HB_UPSCALERS 8
+
+struct kk_hb_upscaler {
+   uint64_t context;
+   int64_t last_use_ns;
+   bool needs_reset;
+   uint32_t flags;
+   void *scaler;
+};
+
+struct kk_cmd_buffer;
+struct kk_device;
+
+bool kk_hb_upscale(struct kk_cmd_buffer *cmd, const VkBlitImageInfo2 *blit,
+                   const VkHbTemporalUpscaleInfo *info);
+void kk_hb_upscale_init(struct kk_device *dev);
+void kk_hb_upscale_finish(struct kk_device *dev);
+void kk_hb_upscale_trim(struct kk_device *dev);
+void kk_hb_upscale_release_cmd(struct kk_cmd_buffer *cmd);
+
+#endif

diff --git a/src/kosmickrisp/vulkan/kk_hb_upscale.c b/src/kosmickrisp/vulkan/kk_hb_upscale.c
new file mode 100644
index 0000000000000000000000000000000000000000..c07af8ec4c492c9bbaf1c5dab47f72618b6c464c
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_hb_upscale.c
@@ -0,0 +1,208 @@
+/*
+ * Copyright 2026 Highball
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_hb_upscale.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_image.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "kosmickrisp/bridge/mtl_upscaler.h"
+
+#include "util/log.h"
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+#define KK_HB_UPSCALER_IDLE_NS (30 * ONE_SECOND_IN_NS)
+
+static mtl_texture *
+kk_hb_upscale_texture(VkImage handle)
+{
+   VK_FROM_HANDLE(kk_image, image, handle);
+   return image ? image->planes[0].mtl_handle : NULL;
+}
+
+void
+kk_hb_upscale_init(struct kk_device *dev)
+{
+   simple_mtx_init(&dev->hb_upscale.lock, mtx_plain);
+   dev->hb_upscale.supported = mtl_upscaler_supported(dev->mtl_handle);
+}
+
+void
+kk_hb_upscale_finish(struct kk_device *dev)
+{
+   for (uint32_t i = 0; i < KK_HB_UPSCALERS; i++) {
+      if (dev->hb_upscale.slots[i].scaler)
+         mtl_release(dev->hb_upscale.slots[i].scaler);
+   }
+   simple_mtx_destroy(&dev->hb_upscale.lock);
+}
+
+void
+kk_hb_upscale_release_cmd(struct kk_cmd_buffer *cmd)
+{
+   util_dynarray_foreach(&cmd->hb_upscalers, mtl_upscaler *, scaler)
+      mtl_release(*scaler);
+   util_dynarray_clear(&cmd->hb_upscalers);
+}
+
+void
+kk_hb_upscale_trim(struct kk_device *dev)
+{
+   if (!p_atomic_read_relaxed(&dev->hb_upscale.has_scalers))
+      return;
+
+   simple_mtx_lock(&dev->hb_upscale.lock);
+   int64_t now = os_time_get_nano();
+   bool has_scalers = false;
+
+   for (uint32_t i = 0; i < KK_HB_UPSCALERS; i++) {
+      struct kk_hb_upscaler *slot = &dev->hb_upscale.slots[i];
+      if (slot->scaler && now - slot->last_use_ns >= KK_HB_UPSCALER_IDLE_NS) {
+         mtl_release(slot->scaler);
+         *slot = (struct kk_hb_upscaler){0};
+      }
+      has_scalers |= slot->scaler != NULL;
+   }
+   p_atomic_set(&dev->hb_upscale.has_scalers, has_scalers);
+   simple_mtx_unlock(&dev->hb_upscale.lock);
+}
+
+static struct kk_hb_upscaler *
+kk_hb_upscaler_get(struct kk_device *dev, uint64_t context, uint32_t flags,
+                   const struct mtl_upscale *upscale)
+{
+   struct kk_hb_upscaler *slot = NULL, *oldest = &dev->hb_upscale.slots[0];
+
+   /* The caller holds the cache lock through encoding because the scaler's
+    * per-dispatch properties are mutable. */
+   for (uint32_t i = 0; i < KK_HB_UPSCALERS; i++) {
+      struct kk_hb_upscaler *s = &dev->hb_upscale.slots[i];
+      if (s->scaler && s->context == context)
+         slot = s;
+      if (s->last_use_ns < oldest->last_use_ns)
+         oldest = s;
+   }
+
+   bool matches = slot && slot->flags == flags &&
+                  mtl_upscaler_matches(slot->scaler, upscale);
+   if (!mtl_upscaler_content_fits(dev->mtl_handle, matches ? slot->scaler : NULL,
+                                  upscale))
+      goto outside_range;
+
+   if (!matches) {
+      mtl_upscaler *scaler = mtl_new_upscaler(dev->mtl_handle,
+                                              dev->mtl_compiler_handle, upscale);
+      if (!scaler)
+         return NULL;
+
+      if (!slot)
+         slot = oldest;
+      if (slot->scaler)
+         mtl_release(slot->scaler);
+      *slot = (struct kk_hb_upscaler) {
+         .context = context,
+         .last_use_ns = os_time_get_nano(),
+         .needs_reset = true,
+         .flags = flags,
+         .scaler = scaler,
+      };
+      p_atomic_set(&dev->hb_upscale.has_scalers, true);
+
+      if (!mtl_upscaler_content_fits(dev->mtl_handle, scaler, upscale))
+         goto outside_range;
+   }
+   return slot;
+
+outside_range:
+   if (slot)
+      slot->needs_reset = true;
+   if (!dev->hb_upscale.logged_content_range) {
+      dev->hb_upscale.logged_content_range = true;
+      mesa_logi("kk: MetalFX content %ux%u is outside the scaler's range; using an ordinary blit",
+                upscale->content_width, upscale->content_height);
+   }
+   return NULL;
+}
+
+bool
+kk_hb_upscale(struct kk_cmd_buffer *cmd, const VkBlitImageInfo2 *blit,
+              const VkHbTemporalUpscaleInfo *info)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+
+   if (!dev->hb_upscale.supported || !info->context || blit->regionCount != 1)
+      return false;
+
+   VK_FROM_HANDLE(kk_image, src, blit->srcImage);
+   VK_FROM_HANDLE(kk_image, dst, blit->dstImage);
+   const VkImageBlit2 *region = &blit->pRegions[0];
+   if (region->srcSubresource.mipLevel || region->srcSubresource.baseArrayLayer ||
+       region->dstSubresource.mipLevel || region->dstSubresource.baseArrayLayer ||
+       region->srcOffsets[0].x || region->srcOffsets[0].y ||
+       region->dstOffsets[0].x || region->dstOffsets[0].y ||
+       region->srcOffsets[1].x <= 0 || region->srcOffsets[1].y <= 0 ||
+       (uint32_t)region->dstOffsets[1].x != dst->vk.extent.width ||
+       (uint32_t)region->dstOffsets[1].y != dst->vk.extent.height)
+      return false;
+
+   struct mtl_upscale upscale = {
+      .color = src->planes[0].mtl_handle,
+      .depth = kk_hb_upscale_texture(info->depth),
+      .motion = kk_hb_upscale_texture(info->motion),
+      .reactive = kk_hb_upscale_texture(info->reactive),
+      .exposure = kk_hb_upscale_texture(info->exposure),
+      .output = dst->planes[0].mtl_handle,
+      .content_width = region->srcOffsets[1].x,
+      .content_height = region->srcOffsets[1].y,
+      .jitter_x = info->jitterX,
+      .jitter_y = info->jitterY,
+      .motion_scale_x = info->motionScaleX,
+      .motion_scale_y = info->motionScaleY,
+      .pre_exposure = info->preExposure,
+      .reset = info->flags & HB_TEMPORAL_UPSCALE_RESET_BIT,
+      .depth_reversed = info->flags & HB_TEMPORAL_UPSCALE_DEPTH_REVERSED_BIT,
+      .auto_exposure = info->flags & HB_TEMPORAL_UPSCALE_AUTO_EXPOSURE_BIT,
+      .motion_at_output = info->flags & HB_TEMPORAL_UPSCALE_MOTION_AT_OUTPUT_BIT,
+   };
+   if (!upscale.color || !upscale.depth || !upscale.motion || !upscale.output)
+      return false;
+
+   uint32_t flags = (info->flags & (HB_TEMPORAL_UPSCALE_AUTO_EXPOSURE_BIT |
+                                    HB_TEMPORAL_UPSCALE_MOTION_AT_OUTPUT_BIT)) |
+                    (upscale.reactive ? 1u << 16 : 0u);
+   simple_mtx_lock(&dev->hb_upscale.lock);
+   struct kk_hb_upscaler *slot = kk_hb_upscaler_get(dev, info->context, flags, &upscale);
+   if (!slot) {
+      simple_mtx_unlock(&dev->hb_upscale.lock);
+      return false;
+   }
+
+   if (slot->needs_reset) {
+      mesa_logi("kk: MetalFX temporal %ux%u, content %ux%u -> %ux%u",
+                src->vk.extent.width, src->vk.extent.height,
+                upscale.content_width, upscale.content_height,
+                dst->vk.extent.width, dst->vk.extent.height);
+      upscale.reset = true;
+      slot->needs_reset = false;
+   }
+   slot->last_use_ns = os_time_get_nano();
+
+   cs_end(cmd);
+   mtl_upscaler_encode(slot->scaler, cmd->metal.cmd_buf, &upscale);
+   util_dynarray_append(&cmd->hb_upscalers, mtl_retain(slot->scaler));
+   simple_mtx_unlock(&dev->hb_upscale.lock);
+
+   /* An all-stage producer barrier covers the scaler's preceding Metal
+    * encoders and later encoders on this queue, even in other command buffers. */
+   mtl_compute_encoder *encoder = mtl_new_compute_command_encoder(cmd->metal.cmd_buf);
+   mtl_barrier_after_stages_device(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   mtl_end_encoding(encoder);
+   mtl_release(encoder);
+   cmd->metal.cmd_buf_used = true;
+   return true;
+}

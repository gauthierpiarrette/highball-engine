+// Highball implicit pipeline cache: writeData() needs two calls, one for the size and one for the data, and a
+// library added between them resets the size, so a live cache is written with the lock held across both.
+VkResult MVKPipelineCache::hbWriteAll(std::vector<char>& out) {
+	lock_guard<mutex> lock(_shaderCacheLock);
+	size_t size = 0;
+	VkResult rslt = writeDataImpl(&size, nullptr);
+	if (rslt != VK_SUCCESS) { return rslt; }
+	if ( !size ) { out.clear(); return VK_SUCCESS; }
+	out.resize(size);
+	rslt = writeDataImpl(&size, out.data());
+	if (rslt == VK_SUCCESS) { out.resize(size); }
+	return rslt;
+}

+// Highball implicit pipeline cache: a library read from cache data compiles its MSL the first time a function is
+// asked for. One compile per library, whichever thread comes first; the others wait on the lock.
+void MVKShaderLibrary::hbCompileLazily() {
+	if ( !_hbLazy.load(std::memory_order_acquire) ) { return; }
+	std::lock_guard<std::mutex> lock(_hbLazyLock);
+	if ( !_hbLazy.load(std::memory_order_acquire) ) { return; }
+	std::string msl;
+	decompressMSL(msl);
+	if ( !msl.empty() ) { compileLibrary(msl, nullptr); }
+	_hbLazy.store(false, std::memory_order_release);

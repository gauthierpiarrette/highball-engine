+// Highball pacing: the minimum time a frame stays on screen, from HB_PRESENT_PACE_FPS (0 = Metal's default).
+static double hbGetPresentMinDuration() {
+	static const char* hbPace = getenv("HB_PRESENT_PACE_FPS");
+	static double fps = hbPace ? atof(hbPace) : 0.0;
+	return fps > 0.0 ? 1.0 / fps : 0.0;
+}

+#ifndef __VKD3D_HB_UPSCALE_H
+#define __VKD3D_HB_UPSCALE_H
+
+/* Highball's temporal upscale. A driver that lists the word "hb-upscale" in
+ * VkPhysicalDeviceDriverProperties::driverInfo (KosmicKrisp with Highball's patch, which runs it on MetalFX's
+ * temporal scaler) upscales a vkCmdBlitImage2 whose VkBlitImageInfo2 carries this structure in its pNext chain:
+ * the blit's source is the color image, its source region the rendered content from the origin, its destination
+ * the output image, whole. A driver that cannot upscale that blit performs it as an ordinary blit. Wine's Vulkan
+ * layer passes the pNext chain of VkBlitImageInfo2 to the driver as it is. The layout below is the interface and
+ * must stay as it is. */
+
+#define VK_STRUCTURE_TYPE_HB_TEMPORAL_UPSCALE_INFO ((VkStructureType)1000999300)
+#define VKD3D_HB_UPSCALE_DRIVER_WORD "hb-upscale"
+
+#define VKD3D_HB_UPSCALE_RESET            0x1u /* the history is dropped */
+#define VKD3D_HB_UPSCALE_DEPTH_REVERSED   0x2u /* depth 1 is near */
+#define VKD3D_HB_UPSCALE_AUTO_EXPOSURE    0x4u /* the scaler computes exposure itself */
+#define VKD3D_HB_UPSCALE_MOTION_AT_OUTPUT 0x8u /* the motion vectors are at the output size */
+
+typedef struct VkHbTemporalUpscaleInfo
+{
+    VkStructureType sType;
+    const void *pNext;
+    uint64_t context;   /* nonzero; the driver keeps one scaler, and its history, per context */
+    uint32_t flags;     /* VKD3D_HB_UPSCALE_* */
+    VkImage depth;      /* required */
+    VkImage motion;     /* required */
+    VkImage reactive;   /* optional */
+    VkImage exposure;   /* optional, 1x1, exposure in red */
+    float jitterX;      /* in input pixels */
+    float jitterY;
+    float motionScaleX; /* to pixels at the motion vectors' size */
+    float motionScaleY;
+    float preExposure;  /* the factor the color input was multiplied by */
+} VkHbTemporalUpscaleInfo;
+
+#endif /* __VKD3D_HB_UPSCALE_H */
diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -7215,6 +7215,8 @@ static void d3d12_command_list_reset_state(struct d3d12_command_list *list,
 {
     d3d12_command_list_reset_api_state(list, initial_pipeline_state);
     d3d12_command_list_reset_internal_state(list);
+    memset(list->hb_compute_root_cbv, 0, sizeof(list->hb_compute_root_cbv));
+    memset(&list->hb_fsr, 0, sizeof(list->hb_fsr));
 }
 
 void d3d12_command_list_invalidate_all_state(struct d3d12_command_list *list)
@@ -9148,6 +9150,350 @@ static void d3d12_command_list_check_compute_barrier(struct d3d12_command_list *
             list->device, list->cmd.vk_command_buffer);
 }
 
+/* Highball: an upscale through vkCmdBlitImage2 with a VkHbTemporalUpscaleInfo (vkd3d_hb_upscale.h), ordered after
+ * everything recorded before it and before everything after it. */
+static void d3d12_command_list_hb_upscale(struct d3d12_command_list *list, VkImage color, VkImage output,
+        uint32_t content_width, uint32_t content_height, uint32_t output_width, uint32_t output_height,
+        const VkHbTemporalUpscaleInfo *info)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    VkDependencyInfo dependency_info;
+    VkBlitImageInfo2 blit_info;
+    VkMemoryBarrier2 barrier;
+    VkImageBlit2 region;
+
+    d3d12_command_list_end_current_render_pass(list, false);
+    d3d12_command_list_end_transfer_batch(list);
+
+    memset(&barrier, 0, sizeof(barrier));
+    barrier.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2;
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_BLIT_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    memset(&dependency_info, 0, sizeof(dependency_info));
+    dependency_info.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dependency_info.memoryBarrierCount = 1;
+    dependency_info.pMemoryBarriers = &barrier;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dependency_info));
+
+    memset(&region, 0, sizeof(region));
+    region.sType = VK_STRUCTURE_TYPE_IMAGE_BLIT_2;
+    region.srcSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = 1;
+    region.srcOffsets[1].x = content_width;
+    region.srcOffsets[1].y = content_height;
+    region.srcOffsets[1].z = 1;
+    region.dstSubresource = region.srcSubresource;
+    region.dstOffsets[1].x = output_width;
+    region.dstOffsets[1].y = output_height;
+    region.dstOffsets[1].z = 1;
+    memset(&blit_info, 0, sizeof(blit_info));
+    blit_info.sType = VK_STRUCTURE_TYPE_BLIT_IMAGE_INFO_2;
+    blit_info.pNext = info;
+    blit_info.srcImage = color;
+    blit_info.srcImageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    blit_info.dstImage = output;
+    blit_info.dstImageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    blit_info.regionCount = 1;
+    blit_info.pRegions = &region;
+    blit_info.filter = VK_FILTER_LINEAR;
+    VK_CALL(vkCmdBlitImage2(list->cmd.vk_command_buffer, &blit_info));
+
+    barrier.srcStageMask = VK_PIPELINE_STAGE_2_BLIT_BIT;
+    barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    barrier.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    VK_CALL(vkCmdPipelineBarrier2(list->cmd.vk_command_buffer, &dependency_info));
+
+    list->cmd.estimated_cost += VKD3D_COMMAND_COST_HIGH;
+}
+
+/* Highball (HB_VKD3D_METALFX_FSR): FSR 3.1's upscaler on the driver's temporal upscale. The game records its FSR
+ * passes as usual. prepare_inputs gives the color (t2), depth (t1) and motion vectors (t0) and the constants (b0);
+ * the passes after it are dropped up to accumulate, which becomes the upscale: into its output (u1), or, when the
+ * game sharpens, into the upscaled color (u0) that the game's RCAS then reads and sharpens into the output.
+ * prepare_reactivity, which has accumulate's binding shape but does not read the game's color, gives the reactive
+ * mask. Everything after accumulate runs as the game ships it. "log" only reports what was found. Bindings from
+ * FidelityFX SDK 1.1.4, src/backends/dx12/shaders; constants as in FSR 3.1's Fsr3UpscalerConstants (dwords: render
+ * size 0-1, upscale size 4-5, jitter 16-17, motion vector scale 20-21, delta pre-exposure 29, frame index 31). */
+enum hb_fsr_mode { HB_FSR_OFF, HB_FSR_LOG, HB_FSR_ON };
+
+static enum hb_fsr_mode hb_fsr_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0)
+    {
+        char value[16];
+        mode = HB_FSR_OFF;
+        if (vkd3d_get_env_var("HB_VKD3D_METALFX_FSR", value, sizeof(value)))
+            mode = !strcmp(value, "log") ? HB_FSR_LOG : (value[0] == '1' ? HB_FSR_ON : HB_FSR_OFF);
+    }
+    return (enum hb_fsr_mode)mode;
+}
+
+static bool hb_fsr_env_switch(const char *name, bool fallback)
+{
+    char value[16];
+    return vkd3d_get_env_var(name, value, sizeof(value)) ? value[0] != '0' : fallback;
+}
+
+static const struct vkd3d_shader_resource_binding *hb_fsr_find_binding(const struct d3d12_root_signature *rs,
+        enum vkd3d_shader_descriptor_type type, unsigned int reg, unsigned int *param_index)
+{
+    const struct vkd3d_shader_root_parameter *p;
+    unsigned int i, j;
+
+    for (i = 0; i < rs->parameter_count; i++)
+    {
+        p = &rs->parameters[i];
+        if (p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+        {
+            for (j = 0; j < p->descriptor_table.binding_count; j++)
+            {
+                const struct vkd3d_shader_resource_binding *b = &p->descriptor_table.first_binding[j];
+                if (b->type == type && b->register_space == 0 && reg >= b->register_index &&
+                        reg - b->register_index < b->register_count)
+                {
+                    *param_index = i;
+                    return b;
+                }
+            }
+        }
+        else if (type == VKD3D_SHADER_DESCRIPTOR_TYPE_CBV && p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_CBV &&
+                p->descriptor.binding && p->descriptor.binding->register_space == 0 &&
+                p->descriptor.binding->register_index == reg)
+        {
+            *param_index = i;
+            return p->descriptor.binding;
+        }
+    }
+    return NULL;
+}
+
+static VkImage hb_fsr_image(struct d3d12_command_list *list, enum vkd3d_shader_descriptor_type type, unsigned int reg)
+{
+    const struct vkd3d_pipeline_bindings *bindings = &list->compute_bindings;
+    const struct vkd3d_shader_resource_binding *b;
+    const struct vkd3d_descriptor_metadata_view *view;
+    unsigned int param;
+
+    if (!bindings->root_signature || !list->cbv_srv_uav_descriptors_view)
+        return VK_NULL_HANDLE;
+    if (!(b = hb_fsr_find_binding(bindings->root_signature, type, reg, &param)))
+        return VK_NULL_HANDLE;
+    view = list->cbv_srv_uav_descriptors_view + bindings->descriptor_tables[b->descriptor_table] +
+            b->descriptor_offset + (reg - b->register_index);
+    if (!(view->info.flags & VKD3D_DESCRIPTOR_FLAG_IMAGE_VIEW) || !view->info.image.view)
+        return VK_NULL_HANDLE;
+    return view->info.image.view->hb_vk_image;
+}
+
+static void hb_fsr_log_bindings(struct d3d12_command_list *list, const char *what)
+{
+    const struct vkd3d_pipeline_bindings *bindings = &list->compute_bindings;
+    const struct vkd3d_shader_resource_binding *b;
+    const struct vkd3d_descriptor_metadata_view *view;
+    char text[1024];
+    unsigned int reg, param, t;
+    size_t len = 0;
+
+    if (!bindings->root_signature || !list->cbv_srv_uav_descriptors_view)
+        return;
+    text[0] = 0;
+    for (t = 0; t < 2 && len < sizeof(text); t++)
+    {
+        for (reg = 0; reg < 12 && len < sizeof(text); reg++)
+        {
+            enum vkd3d_shader_descriptor_type type = t ? VKD3D_SHADER_DESCRIPTOR_TYPE_UAV : VKD3D_SHADER_DESCRIPTOR_TYPE_SRV;
+            if (!(b = hb_fsr_find_binding(bindings->root_signature, type, reg, &param)))
+                continue;
+            view = list->cbv_srv_uav_descriptors_view + bindings->descriptor_tables[b->descriptor_table] +
+                    b->descriptor_offset + (reg - b->register_index);
+            len += snprintf(text + len, sizeof(text) - len, " %c%u=", t ? 'u' : 't', reg);
+            if (len >= sizeof(text))
+                break;
+            if ((view->info.flags & VKD3D_DESCRIPTOR_FLAG_IMAGE_VIEW) && view->info.image.view)
+                len += snprintf(text + len, sizeof(text) - len, "img%#"PRIx64"/vk%u",
+                        (uint64_t)view->info.image.view->hb_vk_image,
+                        view->info.image.view->format ? (unsigned int)view->info.image.view->format->vk_format : 0);
+            else
+                len += snprintf(text + len, sizeof(text) - len, "flags%#x", view->info.flags);
+        }
+    }
+    ERR("HB FSR: %s bindings:%s\n", what, text);
+}
+
+static bool hb_fsr_read_constants(struct d3d12_command_list *list, uint32_t *cb, size_t size)
+{
+    const struct vkd3d_unique_resource *u;
+    const struct vkd3d_shader_resource_binding *b;
+    const struct vkd3d_memory_allocation *allocation;
+    D3D12_GPU_VIRTUAL_ADDRESS va;
+    unsigned int param;
+
+    if (!list->compute_bindings.root_signature ||
+            !(b = hb_fsr_find_binding(list->compute_bindings.root_signature, VKD3D_SHADER_DESCRIPTOR_TYPE_CBV, 0, &param)) ||
+            param >= ARRAY_SIZE(list->hb_compute_root_cbv) || !(va = list->hb_compute_root_cbv[param]))
+        return false;
+    if (!(u = vkd3d_va_map_deref(&list->device->memory_allocator.va_map, va)))
+        return false;
+    allocation = CONTAINING_RECORD(u, struct vkd3d_memory_allocation, resource);
+    if (!allocation->cpu_address || va < u->va || va + size > u->va + u->size)
+        return false;
+    memcpy(cb, (const uint8_t *)allocation->cpu_address + (va - u->va), size);
+    return true;
+}
+
+/* FSR 3.1 passes only the ratio of this frame's pre-exposure to the last one's; the scaler wants the factor itself,
+ * which only has to be consistent from frame to frame, so it is the product of the ratios since the context's last
+ * reset. Kept per context (FSR's prepare_inputs u0, an image of the context) for the last few contexts. */
+static float hb_fsr_pre_exposure(uint64_t context, float delta, bool reset)
+{
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static struct { uint64_t context; float value; uint64_t used; } slots[4];
+    static uint64_t clock;
+    unsigned int i, slot = 0;
+    float value;
+
+    pthread_mutex_lock(&lock);
+    for (i = 0; i < ARRAY_SIZE(slots); i++)
+    {
+        if (slots[i].context == context)
+        {
+            slot = i;
+            break;
+        }
+        if (slots[i].used < slots[slot].used)
+            slot = i;
+    }
+    if (slots[slot].context != context || reset)
+    {
+        slots[slot].context = context;
+        slots[slot].value = 1.0f;
+    }
+    else if (delta > 0.0f && isfinite(delta))
+    {
+        slots[slot].value *= delta;
+        if (!(slots[slot].value > 1.0e-6f && slots[slot].value < 1.0e6f))
+            slots[slot].value = 1.0f;
+    }
+    slots[slot].used = ++clock;
+    value = slots[slot].value;
+    pthread_mutex_unlock(&lock);
+    return value;
+}
+
+/* Returns true when the dispatch is handled (dropped or replaced) */
+static bool hb_fsr_dispatch(struct d3d12_command_list *list)
+{
+    const uint32_t pass = list->state->hb_fsr_pass;
+    enum hb_fsr_mode mode = hb_fsr_mode();
+    static uint32_t logged_passes;
+    VkHbTemporalUpscaleInfo info;
+    VkImage output, reactive;
+    const int32_t *i32;
+    const float *f;
+    bool sharpen;
+
+    if (mode == HB_FSR_ON && !list->device->hb_upscale_supported)
+    {
+        static bool warned;
+        if (!warned)
+            ERR("HB FSR: the driver does not list \"" VKD3D_HB_UPSCALE_DRIVER_WORD "\", FSR runs as the game ships it.\n");
+        warned = true;
+        mode = HB_FSR_LOG;
+    }
+    if (mode == HB_FSR_OFF)
+        return false;
+
+    if (pass == HB_FSR_PASS_PREPARE_INPUTS)
+    {
+        list->hb_fsr.motion = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 0);
+        list->hb_fsr.depth = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 1);
+        list->hb_fsr.color = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 2);
+        list->hb_fsr.context = (uint64_t)hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_UAV, 0);
+        list->hb_fsr.reactive = VK_NULL_HANDLE;
+        list->hb_fsr.have_inputs = list->hb_fsr.color && list->hb_fsr.depth && list->hb_fsr.motion &&
+                list->hb_fsr.context && hb_fsr_read_constants(list, list->hb_fsr.cb, sizeof(list->hb_fsr.cb));
+        if (!(logged_passes & (1u << pass)) || !list->hb_fsr.have_inputs)
+        {
+            if (!(logged_passes & (1u << pass)))
+                hb_fsr_log_bindings(list, "prepare_inputs");
+            logged_passes |= 1u << pass;
+            i32 = (const int32_t *)list->hb_fsr.cb;
+            f = (const float *)list->hb_fsr.cb;
+            ERR("HB FSR: prepare_inputs context %#"PRIx64" color %#"PRIx64" depth %#"PRIx64" mv %#"PRIx64", "
+                    "constants %s: render %dx%d upscale %dx%d jitter %.3f %.3f mv scale %.6f %.6f "
+                    "delta pre-exposure %.3f frame %.0f.\n",
+                    list->hb_fsr.context, (uint64_t)list->hb_fsr.color, (uint64_t)list->hb_fsr.depth,
+                    (uint64_t)list->hb_fsr.motion, list->hb_fsr.have_inputs ? "read" : "MISSING",
+                    i32[0], i32[1], i32[4], i32[5], f[16], f[17], f[20], f[21], f[29], f[31]);
+        }
+        return mode == HB_FSR_ON && list->hb_fsr.have_inputs;
+    }
+
+    if (!list->hb_fsr.have_inputs)
+        return false;
+    if (pass == HB_FSR_PASS_OTHER)
+        return mode == HB_FSR_ON;
+
+    /* prepare_reactivity: t3 the game's reactive mask, t4 its transparency and composition mask; FSR binds one
+     * placeholder to both when the game gives neither */
+    if (hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 8) != list->hb_fsr.color)
+    {
+        reactive = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 3);
+        list->hb_fsr.reactive = reactive != hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 4) ? reactive : VK_NULL_HANDLE;
+        return mode == HB_FSR_ON;
+    }
+
+    output = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_UAV, 1);
+    sharpen = !output;
+    if (sharpen)
+        output = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_UAV, 0);
+    if (!(logged_passes & (1u << pass)))
+    {
+        logged_passes |= 1u << pass;
+        hb_fsr_log_bindings(list, "accumulate");
+        ERR("HB FSR: accumulate writes %#"PRIx64" (%s), reactive mask %#"PRIx64".\n", (uint64_t)output,
+                sharpen ? "the upscaled color the game's RCAS sharpens" : "the output",
+                (uint64_t)list->hb_fsr.reactive);
+    }
+    list->hb_fsr.have_inputs = false;
+    if (mode != HB_FSR_ON || !output)
+        return false;
+
+    i32 = (const int32_t *)list->hb_fsr.cb;
+    f = (const float *)list->hb_fsr.cb;
+    if (i32[0] <= 0 || i32[1] <= 0 || i32[4] <= 0 || i32[5] <= 0)
+        return false;
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_HB_TEMPORAL_UPSCALE_INFO;
+    info.context = list->hb_fsr.context;
+    if (f[31] == 0.0f)
+        info.flags |= VKD3D_HB_UPSCALE_RESET;
+    if (hb_fsr_env_switch("HB_FSR_MFX_DEPTH_REVERSED", true))
+        info.flags |= VKD3D_HB_UPSCALE_DEPTH_REVERSED;
+    if (hb_fsr_env_switch("HB_FSR_MFX_AUTO_EXPOSURE", false))
+        info.flags |= VKD3D_HB_UPSCALE_AUTO_EXPOSURE;
+    if (hb_fsr_env_switch("HB_FSR_MFX_HIRES_MV", false))
+        info.flags |= VKD3D_HB_UPSCALE_MOTION_AT_OUTPUT;
+    info.depth = list->hb_fsr.depth;
+    info.motion = list->hb_fsr.motion;
+    if (hb_fsr_env_switch("HB_FSR_MFX_REACTIVE", true))
+        info.reactive = list->hb_fsr.reactive;
+    info.jitterX = f[16];
+    info.jitterY = f[17];
+    /* FSR's motion vector scale takes the vectors to UV; the scaler wants pixels at the vectors' size */
+    info.motionScaleX = f[20] * (float)(info.flags & VKD3D_HB_UPSCALE_MOTION_AT_OUTPUT ? i32[4] : i32[0]);
+    info.motionScaleY = f[21] * (float)(info.flags & VKD3D_HB_UPSCALE_MOTION_AT_OUTPUT ? i32[5] : i32[1]);

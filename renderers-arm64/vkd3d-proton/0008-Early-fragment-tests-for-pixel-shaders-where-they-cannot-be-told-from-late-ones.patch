From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gauthier Piarrette <gauthierpiarrette@gmail.com>
Date: Sun, 18 Oct 2026 13:45:00 +0200
Subject: [PATCH] Early fragment tests for pixel shaders where they cannot be
 told from late ones

Pixel shaders of graphics pipelines without alpha-to-coverage get dxil-spirv's
DXIL_SPV_OPTION_EARLY_FRAGMENT_TESTS_WHEN_SAFE (renderers-arm64/dxil-spirv 0001):
EarlyFragmentTests when the shader has no side effects, no discard and no depth,
stencil or coverage output, the rule dxil-spirv already applies to shaders it
instruments for descriptor QA. For such a shader early and late tests give the
same image; alpha-to-coverage is the one pipeline state that tells them apart
(early tests write depth before the shader's alpha trims the coverage), so those
pipelines keep late tests. The shader revision goes from 1 to 2, so pipeline
libraries and disk caches written before drop their SPIR-V.

Microsoft Flight Simulator 2024's terrain G-buffer pass stopped the GPU (Metal's
watchdog, "Caused GPU Hang Error", a half-second freeze in flight) about once per
13,000 frames on its start screen on an M4; with the terrain fragment shader
instrumented by descriptor QA, which added EarlyFragmentTests to it, 74,000 frames
in two runs had none.
---
diff --git a/include/vkd3d_shader.h b/include/vkd3d_shader.h
index 7781306..3f37fbf 100644
--- a/include/vkd3d_shader.h
+++ b/include/vkd3d_shader.h
@@ -583,6 +583,8 @@ struct vkd3d_shader_compile_arguments
     const struct vkd3d_shader_parameter *parameters;
 
     bool dual_source_blending;
+    /* Pixel shaders get early fragment tests where they cannot be told from late ones (Highball). */
+    bool early_fragment_tests_when_safe;
     const unsigned int *output_swizzles;
     unsigned int output_swizzle_count;
 
diff --git a/libs/vkd3d-shader/dxil.c b/libs/vkd3d-shader/dxil.c
index 3084e35..f29353f 100644
--- a/libs/vkd3d-shader/dxil.c
+++ b/libs/vkd3d-shader/dxil.c
@@ -1202,6 +1202,14 @@ static int vkd3d_dxil_converter_set_options(dxil_spv_converter converter,
             }
         }
 
+        if (compiler_args->early_fragment_tests_when_safe)
+        {
+            static const dxil_spv_option_early_fragment_tests_when_safe helper =
+                    { { DXIL_SPV_OPTION_EARLY_FRAGMENT_TESTS_WHEN_SAFE }, DXIL_SPV_TRUE };
+            if (dxil_spv_converter_add_option(converter, &helper.base) != DXIL_SPV_SUCCESS)
+                WARN("dxil-spirv does not support EARLY_FRAGMENT_TESTS_WHEN_SAFE.\n");
+        }
+
         if (compiler_args->output_swizzle_count != 0)
         {
             const dxil_spv_option_output_swizzle helper =
diff --git a/libs/vkd3d-shader/vkd3d_shader_main.c b/libs/vkd3d-shader/vkd3d_shader_main.c
index 408745d..e0dadc4 100644
--- a/libs/vkd3d-shader/vkd3d_shader_main.c
+++ b/libs/vkd3d-shader/vkd3d_shader_main.c
@@ -531,7 +531,9 @@ uint64_t vkd3d_shader_get_revision(void)
      * Might get nuked later ...
      * It's not immediately useful for invalidating pipeline caches, since that would mostly be covered
      * by vkd3d-proton Git hash. */
-    return quirk_hash ^ 1;
+    /* Highball: 2 since pixel shaders get early fragment tests where they cannot be told from late ones, so
+     * pipeline libraries and disk caches written before drop their SPIR-V. */
+    return quirk_hash ^ 2;
 }
 
 struct vkd3d_shader_stage_io_entry *vkd3d_shader_stage_io_map_append(struct vkd3d_shader_stage_io_map *map,
diff --git a/libs/vkd3d/state.c b/libs/vkd3d/state.c
index 875e570..c5ae910 100644
--- a/libs/vkd3d/state.c
+++ b/libs/vkd3d/state.c
@@ -2752,6 +2752,8 @@ static void d3d12_pipeline_state_init_compile_arguments(struct d3d12_pipeline_st
     {
         /* Options which are exclusive to PS. Especially output swizzles must only be used in PS. */
         compile_arguments->dual_source_blending = state->graphics.cached_desc.is_dual_source_blending;
+        /* With alpha-to-coverage, early tests would write depth before the shader's alpha trims the coverage. */
+        compile_arguments->early_fragment_tests_when_safe = !state->graphics.cached_desc.is_alpha_to_coverage;
         compile_arguments->output_swizzles = state->graphics.cached_desc.ps_output_swizzle;
         compile_arguments->output_swizzle_count = state->graphics.rt_count;
     }
@@ -5229,6 +5231,7 @@ static HRESULT d3d12_pipeline_state_init_graphics_create_info(struct d3d12_pipel
     }
 
     graphics->cached_desc.is_dual_source_blending = is_dual_source_blending(&desc->blend_state.RenderTarget[0]);
+    graphics->cached_desc.is_alpha_to_coverage = !!desc->blend_state.AlphaToCoverageEnable;
 
     if (graphics->cached_desc.is_dual_source_blending)
     {
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index dff8343..121dd86 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -2159,6 +2159,7 @@ struct d3d12_graphics_pipeline_state_cached_desc
     struct vkd3d_shader_parameter shader_parameters[3];
     unsigned int shader_parameters_count;
     bool is_dual_source_blending;
+    bool is_alpha_to_coverage;
     VkShaderStageFlagBits xfb_stage;
     struct vkd3d_shader_transform_feedback_info *xfb_info;
     struct vkd3d_shader_stage_io_map stage_io_map_ms_ps;

From b360b9e2c3cafa3af6c7e2cbcf5947969c08f1cf Mon Sep 17 00:00:00 2001
From: Avery Felts <averyfelts@aol.com>
Date: Sun, 15 Nov 2026 16:24:05 -0700
Subject: [PATCH 18/27] MetalSharp: ID3D12GraphicsCommandListMetalFX1, a
 temporal upscale with a reactive mask, jittered motion vectors and region
 offsets

TemporalUpscale1 takes VKD3D_METALFX_TEMPORAL_DESC1: DLSS's MVJittered, its
bias mask as MetalFX's reactive mask, and its subrect bases. QueryInterface
for IID_ID3D12GraphicsCommandListMetalFX1 gives the same interface, whose
vtable then has it; an NGX core from before calls TemporalUpscale as it did.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/private/mvk_metalfx.h   | 16 +++++++++++
 include/private/vkd3d_metalfx.h | 22 ++++++++++++++
 libs/vkd3d/command.c            |  2 +-
 libs/vkd3d/metalfx.c            | 51 ++++++++++++++++++++++++++++-----
 4 files changed, 83 insertions(+), 8 deletions(-)

diff --git a/include/private/mvk_metalfx.h b/include/private/mvk_metalfx.h
index cc9a9eaa..ddca7980 100644
--- a/include/private/mvk_metalfx.h
+++ b/include/private/mvk_metalfx.h
@@ -30,6 +30,7 @@ extern "C" {
 #define VK_STRUCTURE_TYPE_METALFX_SCALE_INFO_MVK ((VkStructureType)1000999100)
 #define VK_STRUCTURE_TYPE_SWAPCHAIN_METALFX_SPATIAL_CREATE_INFO_MVK ((VkStructureType)1000999101)
 #define VK_STRUCTURE_TYPE_METALFX_FRAME_INTERPOLATION_INFO_MVK ((VkStructureType)1000999102)
+#define VK_STRUCTURE_TYPE_METALFX_CONTENT_OFFSETS_MVK ((VkStructureType)1000999103)
 
 #define VK_MVK_METALFX_DRIVER_INFO "metalfx"
 #define VK_MVK_METALFX_DENOISED_DRIVER_INFO "metalfx-denoised"
@@ -60,6 +61,9 @@ typedef enum VkMetalFXImageMVK {
 	/* Frame interpolation: color, depth, motion, output and, optionally, the UI (color and alpha) in the denoised
 	 * diffuse albedo's place. Depth and motion are at the render size, the others at the swapchain's. */
 	VK_METALFX_IMAGE_UI_MVK = VK_METALFX_IMAGE_DIFFUSE_ALBEDO_MVK,
+	/* Temporal: the reactive mask (optional, one channel, 1 favoring the current frame: DLSS's
+	 * Bias.Current.Color.Mask), in the denoised diffuse albedo's place. A MoltenVK before it ignores it. */
+	VK_METALFX_IMAGE_REACTIVE_MVK = VK_METALFX_IMAGE_DIFFUSE_ALBEDO_MVK,
 } VkMetalFXImageMVK;
 
 typedef enum VkMetalFXScaleFlagBitsMVK {
@@ -68,6 +72,9 @@ typedef enum VkMetalFXScaleFlagBitsMVK {
 	VK_METALFX_SCALE_DEPTH_REVERSED_BIT_MVK = 0x4,
 	/* The motion vectors are at the output resolution (DLSS without MV_LOWRES): they are brought to the input's. */
 	VK_METALFX_SCALE_MOTION_DISPLAY_RES_BIT_MVK = 0x8,
+	/* Temporal: the motion vectors include the camera jitter (DLSS's MVJittered), which MetalFX takes out with the
+	 * jitter offset where it can (macOS 27). */
+	VK_METALFX_SCALE_JITTERED_MOTION_BIT_MVK = 0x10,
 } VkMetalFXScaleFlagBitsMVK;
 
 /*
@@ -114,6 +121,15 @@ typedef struct VkMetalFXFrameInterpolationInfoMVK {
 	uint32_t uiComposited;					/* the UI image's contents are in the color image too */
 } VkMetalFXFrameInterpolationInfoMVK;
 
+/* Temporal: where each image's region starts, in pixels (DLSS's subrect bases), in the pNext chain of its
+ * VkMetalFXScaleInfoMVK; MetalFX reads the regions in place where it can (macOS 27). */
+typedef struct VkMetalFXContentOffsetsMVK {
+	VkStructureType sType;
+	const void* pNext;
+	uint32_t offsetX[VK_METALFX_IMAGE_COUNT_MVK];	/* by VkMetalFXImageMVK: color, depth, motion, output, reactive */
+	uint32_t offsetY[VK_METALFX_IMAGE_COUNT_MVK];
+} VkMetalFXContentOffsetsMVK;
+
 /* MetalFX spatial upscaling at present, to the surface's native size, where that is larger than the images' */
 typedef struct VkSwapchainMetalFXSpatialCreateInfoMVK {
 	VkStructureType sType;
diff --git a/include/private/vkd3d_metalfx.h b/include/private/vkd3d_metalfx.h
index 450df1f2..aa9f4b23 100644
--- a/include/private/vkd3d_metalfx.h
+++ b/include/private/vkd3d_metalfx.h
@@ -44,6 +44,20 @@ typedef struct VKD3D_METALFX_TEMPORAL_DESC
     FLOAT JitterOffsetY;
 } VKD3D_METALFX_TEMPORAL_DESC;
 
+/* TemporalUpscale1's (ID3D12GraphicsCommandListMetalFX1): DLSS's MVJittered, bias mask and subrect bases. */
+typedef struct VKD3D_METALFX_TEMPORAL_DESC1
+{
+    VKD3D_METALFX_TEMPORAL_DESC Desc;
+    BOOL JitteredMotionVectors;   /* the motion vectors include the jitter */
+    ID3D12Resource *ReactiveMask; /* optional: one channel, 1 favoring the current frame (DLSS's Bias.Current.Color) */
+    /* where each resource's region starts, in pixels */
+    UINT ColorOffsetX, ColorOffsetY;
+    UINT DepthOffsetX, DepthOffsetY;
+    UINT MotionVectorOffsetX, MotionVectorOffsetY;
+    UINT ReactiveMaskOffsetX, ReactiveMaskOffsetY;
+    UINT OutputOffsetX, OutputOffsetY;
+} VKD3D_METALFX_TEMPORAL_DESC1;
+
 typedef struct VKD3D_METALFX_DENOISED_DESC
 {
     BOOL AutoExposure;
@@ -124,6 +138,10 @@ typedef struct ID3D12GraphicsCommandListMetalFXVtbl
     BOOL (STDMETHODCALLTYPE *SupportsFrameInterpolation)(ID3D12GraphicsCommandListMetalFX *This);
     HRESULT (STDMETHODCALLTYPE *FrameInterpolate)(ID3D12GraphicsCommandListMetalFX *This,
             const VKD3D_METALFX_FRAME_INTERPOLATE_DESC *desc, ID3D12MetalFXScaler **interpolator);
+    /* Only where QueryInterface gives IID_ID3D12GraphicsCommandListMetalFX1 (the same interface): TemporalUpscale
+     * with VKD3D_METALFX_TEMPORAL_DESC1's inputs, on the same scaler. */
+    HRESULT (STDMETHODCALLTYPE *TemporalUpscale1)(ID3D12GraphicsCommandListMetalFX *This,
+            const VKD3D_METALFX_TEMPORAL_DESC1 *desc, ID3D12MetalFXScaler **upscaler);
 } ID3D12GraphicsCommandListMetalFXVtbl;
 
 struct ID3D12GraphicsCommandListMetalFX
@@ -135,4 +153,8 @@ struct ID3D12GraphicsCommandListMetalFX
 static const GUID IID_ID3D12GraphicsCommandListMetalFX =
         {0xb2697de8, 0x21af, 0x4406, {0x91, 0xf8, 0x73, 0xa2, 0xfd, 0xd2, 0x70, 0x29}};
 
+/* 6f0d1a4c-3e52-4b8a-9c1d-5a7e2b9f4c61: ID3D12GraphicsCommandListMetalFX with TemporalUpscale1 */
+static const GUID IID_ID3D12GraphicsCommandListMetalFX1 =
+        {0x6f0d1a4c, 0x3e52, 0x4b8a, {0x9c, 0x1d, 0x5a, 0x7e, 0x2b, 0x9f, 0x4c, 0x61}};
+
 #endif
diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 42bbd5e9..0fe359df 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -6571,7 +6571,7 @@ HRESULT STDMETHODCALLTYPE d3d12_command_list_QueryInterface(d3d12_command_list_i
         return S_OK;
     }
 
-    if (IsEqualGUID(iid, &IID_ID3D12GraphicsCommandListMetalFX))
+    if (IsEqualGUID(iid, &IID_ID3D12GraphicsCommandListMetalFX) || IsEqualGUID(iid, &IID_ID3D12GraphicsCommandListMetalFX1))
     {
         d3d12_command_list_metalfx_AddRef(&command_list->ID3D12GraphicsCommandListMetalFX_iface);
         *object = &command_list->ID3D12GraphicsCommandListMetalFX_iface;
diff --git a/libs/vkd3d/metalfx.c b/libs/vkd3d/metalfx.c
index 87a12439..19cac7f3 100644
--- a/libs/vkd3d/metalfx.c
+++ b/libs/vkd3d/metalfx.c
@@ -191,15 +191,13 @@ static void vkd3d_metalfx_record(struct d3d12_command_list *list, VkMetalFXScale
     d3d12_command_list_metalfx_scale(list, info, resources, VK_METALFX_IMAGE_COUNT_MVK);
 }
 
-static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_TemporalUpscale(ID3D12GraphicsCommandListMetalFX *iface,
-        const VKD3D_METALFX_TEMPORAL_DESC *desc, ID3D12MetalFXScaler **upscaler)
+static HRESULT d3d12_command_list_metalfx_temporal_upscale(struct d3d12_command_list *list,
+        const VKD3D_METALFX_TEMPORAL_DESC *desc, const VKD3D_METALFX_TEMPORAL_DESC1 *desc1, ID3D12MetalFXScaler **upscaler)
 {
-    struct d3d12_command_list *list = impl_from_ID3D12GraphicsCommandListMetalFX(iface);
     struct d3d12_resource *resources[VK_METALFX_IMAGE_COUNT_MVK] = {0};
+    VkMetalFXContentOffsetsMVK offsets;
     VkMetalFXScaleInfoMVK info;
 
-    TRACE("iface %p, desc %p, upscaler %p.\n", iface, desc, upscaler);
-
     if (!desc || !upscaler || !desc->Color || !desc->Depth || !desc->MotionVector || !desc->Output)
         return E_INVALIDARG;
     if (!vkd3d_metalfx_driver_has(list->device, VK_MVK_METALFX_DRIVER_INFO))
@@ -210,17 +208,35 @@ static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_TemporalUpscale(ID3D
             !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_DEPTH_MVK, desc->Depth, false) ||
             !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_MOTION_MVK, desc->MotionVector, true) ||
             !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_OUTPUT_MVK, desc->Output, false) ||
-            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_EXPOSURE_MVK, desc->ExposureTexture, false))
+            !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_EXPOSURE_MVK, desc->ExposureTexture, false) ||
+            (desc1 && !vkd3d_metalfx_set_image(&info, resources, VK_METALFX_IMAGE_REACTIVE_MVK, desc1->ReactiveMask, false)))
         return E_INVALIDARG;
     if (!(info.scalerId = vkd3d_metalfx_upscaler_id(upscaler)))
         return E_OUTOFMEMORY;
 
+    if (desc1)
+    {
+        memset(&offsets, 0, sizeof(offsets));
+        offsets.sType = VK_STRUCTURE_TYPE_METALFX_CONTENT_OFFSETS_MVK;
+        offsets.offsetX[VK_METALFX_IMAGE_COLOR_MVK] = desc1->ColorOffsetX;
+        offsets.offsetY[VK_METALFX_IMAGE_COLOR_MVK] = desc1->ColorOffsetY;
+        offsets.offsetX[VK_METALFX_IMAGE_DEPTH_MVK] = desc1->DepthOffsetX;
+        offsets.offsetY[VK_METALFX_IMAGE_DEPTH_MVK] = desc1->DepthOffsetY;
+        offsets.offsetX[VK_METALFX_IMAGE_MOTION_MVK] = desc1->MotionVectorOffsetX;
+        offsets.offsetY[VK_METALFX_IMAGE_MOTION_MVK] = desc1->MotionVectorOffsetY;
+        offsets.offsetX[VK_METALFX_IMAGE_REACTIVE_MVK] = desc1->ReactiveMaskOffsetX;
+        offsets.offsetY[VK_METALFX_IMAGE_REACTIVE_MVK] = desc1->ReactiveMaskOffsetY;
+        offsets.offsetX[VK_METALFX_IMAGE_OUTPUT_MVK] = desc1->OutputOffsetX;
+        offsets.offsetY[VK_METALFX_IMAGE_OUTPUT_MVK] = desc1->OutputOffsetY;
+        info.pNext = &offsets;
+    }
     info.scalerType = VK_METALFX_SCALER_TYPE_TEMPORAL_MVK;
     info.flags = (desc->AutoExposure ? VK_METALFX_SCALE_AUTO_EXPOSURE_BIT_MVK : 0) |
             (desc->InReset ? VK_METALFX_SCALE_RESET_BIT_MVK : 0) |
             (desc->DepthReversed ? VK_METALFX_SCALE_DEPTH_REVERSED_BIT_MVK : 0) |
             /* MoltenVK brings them to the input resolution (Hogwarts Legacy's DLSS gives them at the output's). */
-            (desc->MotionVectorInDisplayRes ? VK_METALFX_SCALE_MOTION_DISPLAY_RES_BIT_MVK : 0);
+            (desc->MotionVectorInDisplayRes ? VK_METALFX_SCALE_MOTION_DISPLAY_RES_BIT_MVK : 0) |
+            (desc1 && desc1->JitteredMotionVectors ? VK_METALFX_SCALE_JITTERED_MOTION_BIT_MVK : 0);
     info.inputContentWidth = desc->InputContentWidth;
     info.inputContentHeight = desc->InputContentHeight;
     info.motionVectorScaleX = desc->MotionVectorScaleX;
@@ -232,6 +248,26 @@ static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_TemporalUpscale(ID3D
     return S_OK;
 }
 
+static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_TemporalUpscale(ID3D12GraphicsCommandListMetalFX *iface,
+        const VKD3D_METALFX_TEMPORAL_DESC *desc, ID3D12MetalFXScaler **upscaler)
+{
+    TRACE("iface %p, desc %p, upscaler %p.\n", iface, desc, upscaler);
+
+    return d3d12_command_list_metalfx_temporal_upscale(impl_from_ID3D12GraphicsCommandListMetalFX(iface),
+            desc, NULL, upscaler);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_TemporalUpscale1(ID3D12GraphicsCommandListMetalFX *iface,
+        const VKD3D_METALFX_TEMPORAL_DESC1 *desc, ID3D12MetalFXScaler **upscaler)
+{
+    TRACE("iface %p, desc %p, upscaler %p.\n", iface, desc, upscaler);
+
+    if (!desc)
+        return E_INVALIDARG;
+    return d3d12_command_list_metalfx_temporal_upscale(impl_from_ID3D12GraphicsCommandListMetalFX(iface),
+            &desc->Desc, desc, upscaler);
+}
+
 static HRESULT STDMETHODCALLTYPE d3d12_command_list_metalfx_DenoisedUpscale(ID3D12GraphicsCommandListMetalFX *iface,
         const VKD3D_METALFX_DENOISED_DESC *desc, ID3D12MetalFXScaler **upscaler)
 {
@@ -353,6 +389,7 @@ CONST_VTBL struct ID3D12GraphicsCommandListMetalFXVtbl d3d12_command_list_metalf
     d3d12_command_list_metalfx_DenoisedUpscale,
     d3d12_command_list_metalfx_SupportsFrameInterpolation,
     d3d12_command_list_metalfx_FrameInterpolate,
+    d3d12_command_list_metalfx_TemporalUpscale1,
 };
 
 /* vkd3d.conf: the file VKD3D_CONFIG_FILE names, else vkd3d.conf in the working directory, in dxvk.conf's form:
-- 

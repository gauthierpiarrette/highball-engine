diff --git a/libs/vkd3d/state.c b/libs/vkd3d/state.c
index ed723b14..3f90883d 100644
--- a/libs/vkd3d/state.c
+++ b/libs/vkd3d/state.c
@@ -3724,6 +3724,34 @@ static HRESULT vkd3d_create_compute_pipeline(struct d3d12_pipeline_state *state,
     return S_OK;
 }
 
+static bool hb_bytes_contain(const void *data, size_t size, const char *needle)
+{
+    size_t length = strlen(needle), i;
+    const char *bytes = data;
+
+    if (!data || size < length)
+        return false;
+    for (i = 0; i + length <= size; i++)
+    {
+        if (bytes[i] == needle[0] && !memcmp(bytes + i, needle, length))
+            return true;
+    }
+    return false;
+}
+
+/* Highball: FSR 3.1's passes keep their resource names in the DXIL (FidelityFX SDK 1.1, the dx12 *_pass.hlsl). */
+static uint32_t hb_fsr_classify(const void *code, size_t size)
+{
+    if (!hb_bytes_contain(code, size, "cbFSR3Upscaler"))
+        return HB_FSR_PASS_NONE;
+    if (hb_bytes_contain(code, size, "rw_upscaled_output"))
+        return hb_bytes_contain(code, size, "rw_internal_upscaled_color") ? HB_FSR_PASS_ACCUMULATE : HB_FSR_PASS_RCAS;
+    if (hb_bytes_contain(code, size, "r_input_color_jittered") && hb_bytes_contain(code, size, "r_input_depth") &&
+            hb_bytes_contain(code, size, "rw_dilated_motion_vectors"))
+        return HB_FSR_PASS_PREPARE_INPUTS;
+    return HB_FSR_PASS_OTHER;
+}
+
 static HRESULT d3d12_pipeline_state_init_compute(struct d3d12_pipeline_state *state,
         struct d3d12_device *device, const struct d3d12_pipeline_state_desc *desc,
         const struct d3d12_cached_pipeline_state *cached_pso)
@@ -3750,6 +3778,8 @@ static HRESULT d3d12_pipeline_state_init_compute(struct d3d12_pipeline_state *st
         return hr;
     }
 
+    state->hb_fsr_pass = hb_fsr_classify(desc->cs.pShaderBytecode, desc->cs.BytecodeLength);
+
     if (FAILED(hr = vkd3d_private_store_init(&state->private_store)))
     {
         VK_CALL(vkDestroyPipeline(device->vk_device, state->compute.vk_pipeline, NULL));

 };
 
 /* ID3D12PipelineState */
+/* Highball (HB_VKD3D_METALFX_FSR): FSR 3.1 upscaler passes, recognized by the resource names in their DXIL */
+enum hb_fsr_pass
+{
+    HB_FSR_PASS_NONE = 0,
+    HB_FSR_PASS_OTHER,
+    HB_FSR_PASS_PREPARE_INPUTS,
+    HB_FSR_PASS_ACCUMULATE,
+    HB_FSR_PASS_RCAS,
+};
+
 struct d3d12_pipeline_state
 {
     ID3D12PipelineState ID3D12PipelineState_iface;
@@ -2434,6 +2445,7 @@ struct d3d12_pipeline_state
     bool root_signature_compat_hash_is_dxbc_derived;
     bool pso_is_loaded_from_cached_blob;
     bool pso_is_fully_dynamic;
+    uint32_t hb_fsr_pass; /* Highball: enum hb_fsr_pass, FSR 3.1 compute passes recognized by resource names */
 
     struct vkd3d_private_store private_store;
     struct d3d_destruction_notifier destruction_notifier;
@@ -3443,6 +3455,15 @@ struct d3d12_command_list
     ID3D12GraphicsCommandListMetalFX ID3D12GraphicsCommandListMetalFX_iface; /* MetalSharp: MetalFX for the NGX core (metalfx.c) */
     LONG refcount;
 
+    /* Highball (HB_VKD3D_METALFX_FSR): the compute root CBVs as set, and the FSR 3.1 inputs seen this frame */
+    D3D12_GPU_VIRTUAL_ADDRESS hb_compute_root_cbv[D3D12_MAX_ROOT_COST];
+    struct
+    {
+        VkImage color, depth, motion;
+        uint32_t cb[32];
+        bool have_inputs;
+    } hb_fsr;
+
     D3D12_COMMAND_LIST_TYPE type;
     VkQueueFlags vk_queue_flags;
 

From 771eb59018fe251902af287a51b1695803a8690b Mon Sep 17 00:00:00 2001
From: hb <hb@local>
Date: Tue, 17 Nov 2026 06:22:02 +0500
Subject: [PATCH 20/27] HB_VKD3D_METALFX_FSR: FSR 3.1's upscaler passes on
 MetalFX's temporal scaler, recognized by resource names (log or 1)

---
 libs/vkd3d/command.c       | 189 ++++++++++++++++++++++++++++++++++++-
 libs/vkd3d/resource.c      |   1 +
 libs/vkd3d/state.c         |  30 ++++++
 libs/vkd3d/vkd3d_private.h |  21 +++++
 4 files changed, 240 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 0fe359df..b7abbddc 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -9393,6 +9393,188 @@ static void d3d12_command_list_check_compute_barrier(struct d3d12_command_list *
             list->device, list->cmd.vk_command_buffer);
 }
 
+/* Highball (HB_VKD3D_METALFX_FSR): FSR 3.1's upscaler on MetalFX's temporal scaler. The game's FSR records its passes
+ * as usual; prepare_inputs gives the color (t2), depth (t1) and motion vectors (t0) and the constants (b0), the pass
+ * that writes the output (accumulate u1, or RCAS u0 with sharpening) becomes one MetalFX scale, and the others are
+ * dropped. "log" only reports what was found. Bindings from FidelityFX SDK 1.1.4, src/backends/dx12/shaders. */
+enum hb_fsr_mode { HB_FSR_OFF, HB_FSR_LOG, HB_FSR_ON };
+
+static enum hb_fsr_mode hb_fsr_mode(void)
+{
+    static int mode = -1;
+    if (mode < 0)
+    {
+        char value[16];
+        mode = HB_FSR_OFF;
+        if (vkd3d_get_env_var("HB_VKD3D_METALFX_FSR", value, sizeof(value)))
+            mode = !strcmp(value, "log") ? HB_FSR_LOG : (value[0] == '1' ? HB_FSR_ON : HB_FSR_OFF);
+    }
+    return (enum hb_fsr_mode)mode;
+}
+
+static float hb_fsr_env_float(const char *name, float fallback)
+{
+    char value[32];
+    return vkd3d_get_env_var(name, value, sizeof(value)) ? (float)atof(value) : fallback;
+}
+
+static const struct vkd3d_shader_resource_binding *hb_fsr_find_binding(const struct d3d12_root_signature *rs,
+        enum vkd3d_shader_descriptor_type type, unsigned int reg, unsigned int *param_index)
+{
+    const struct vkd3d_shader_root_parameter *p;
+    unsigned int i, j;
+
+    for (i = 0; i < rs->parameter_count; i++)
+    {
+        p = &rs->parameters[i];
+        if (p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+        {
+            for (j = 0; j < p->descriptor_table.binding_count; j++)
+            {
+                const struct vkd3d_shader_resource_binding *b = &p->descriptor_table.first_binding[j];
+                if (b->type == type && b->register_space == 0 && reg >= b->register_index &&
+                        reg - b->register_index < b->register_count)
+                {
+                    *param_index = i;
+                    return b;
+                }
+            }
+        }
+        else if (type == VKD3D_SHADER_DESCRIPTOR_TYPE_CBV && p->parameter_type == D3D12_ROOT_PARAMETER_TYPE_CBV &&
+                p->descriptor.binding && p->descriptor.binding->register_space == 0 &&
+                p->descriptor.binding->register_index == reg)
+        {
+            *param_index = i;
+            return p->descriptor.binding;
+        }
+    }
+    return NULL;
+}
+
+static VkImage hb_fsr_image(struct d3d12_command_list *list, enum vkd3d_shader_descriptor_type type, unsigned int reg)
+{
+    const struct vkd3d_pipeline_bindings *bindings = &list->compute_bindings;
+    const struct vkd3d_shader_resource_binding *b;
+    const struct vkd3d_descriptor_metadata_view *view;
+    unsigned int param;
+
+    if (!bindings->root_signature || !list->cbv_srv_uav_descriptors_view)
+        return VK_NULL_HANDLE;
+    if (!(b = hb_fsr_find_binding(bindings->root_signature, type, reg, &param)))
+        return VK_NULL_HANDLE;
+    view = list->cbv_srv_uav_descriptors_view + bindings->descriptor_tables[b->descriptor_table] +
+            b->descriptor_offset + (reg - b->register_index);
+    if (!(view->info.flags & VKD3D_DESCRIPTOR_FLAG_IMAGE_VIEW) || !view->info.image.view)
+        return VK_NULL_HANDLE;
+    return view->info.image.view->hb_vk_image;
+}
+
+static bool hb_fsr_read_constants(struct d3d12_command_list *list, uint32_t *cb, size_t size)
+{
+    const struct vkd3d_unique_resource *u;
+    const struct vkd3d_shader_resource_binding *b;
+    const struct vkd3d_memory_allocation *allocation;
+    D3D12_GPU_VIRTUAL_ADDRESS va;
+    unsigned int param;
+
+    if (!list->compute_bindings.root_signature ||
+            !(b = hb_fsr_find_binding(list->compute_bindings.root_signature, VKD3D_SHADER_DESCRIPTOR_TYPE_CBV, 0, &param)) ||
+            param >= ARRAY_SIZE(list->hb_compute_root_cbv) || !(va = list->hb_compute_root_cbv[param]))
+        return false;
+    if (!(u = vkd3d_va_map_deref(&list->device->memory_allocator.va_map, va)))
+        return false;
+    allocation = CONTAINING_RECORD(u, struct vkd3d_memory_allocation, resource);
+    if (!allocation->cpu_address || va < u->va || va + size > u->va + u->size)
+        return false;
+    memcpy(cb, (const uint8_t *)allocation->cpu_address + (va - u->va), size);
+    return true;
+}
+
+/* Returns true when the dispatch is handled (dropped or replaced) */
+static bool hb_fsr_dispatch(struct d3d12_command_list *list)
+{
+    const uint32_t pass = list->state->hb_fsr_pass;
+    enum hb_fsr_mode mode = hb_fsr_mode();
+    static uint32_t logged_passes;
+    VkMetalFXScaleInfoMVK info;
+    const float *f;
+    const int32_t *i32;
+    VkImage output;
+    bool hires_mv;
+    float target_w, target_h;
+
+    if (mode == HB_FSR_OFF)
+        return false;
+
+    if (pass == HB_FSR_PASS_PREPARE_INPUTS)
+    {
+        list->hb_fsr.motion = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 0);
+        list->hb_fsr.depth = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 1);
+        list->hb_fsr.color = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_SRV, 2);
+        list->hb_fsr.have_inputs = list->hb_fsr.color && list->hb_fsr.depth && list->hb_fsr.motion &&
+                hb_fsr_read_constants(list, list->hb_fsr.cb, sizeof(list->hb_fsr.cb));
+        if (!(logged_passes & (1u << pass)) || !list->hb_fsr.have_inputs)
+        {
+            logged_passes |= 1u << pass;
+            i32 = (const int32_t *)list->hb_fsr.cb;
+            f = (const float *)list->hb_fsr.cb;
+            ERR("HB FSR: prepare_inputs color %#"PRIx64" depth %#"PRIx64" mv %#"PRIx64", constants %s: render %dx%d "
+                    "upscale %dx%d jitter %.3f %.3f mv scale %.6f %.6f frame %.0f.\n",
+                    (uint64_t)list->hb_fsr.color, (uint64_t)list->hb_fsr.depth, (uint64_t)list->hb_fsr.motion,
+                    list->hb_fsr.have_inputs ? "read" : "MISSING", i32[0], i32[1], i32[4], i32[5], f[16], f[17],
+                    f[20], f[21], f[31]);
+        }
+        return mode == HB_FSR_ON && list->hb_fsr.have_inputs;
+    }
+
+    if (pass == HB_FSR_PASS_OTHER)
+        return mode == HB_FSR_ON && list->hb_fsr.have_inputs;
+
+    output = hb_fsr_image(list, VKD3D_SHADER_DESCRIPTOR_TYPE_UAV, pass == HB_FSR_PASS_ACCUMULATE ? 1 : 0);
+    if (!(logged_passes & (1u << pass)))
+    {
+        logged_passes |= 1u << pass;
+        ERR("HB FSR: %s output %#"PRIx64", inputs %s.\n", pass == HB_FSR_PASS_ACCUMULATE ? "accumulate" : "rcas",
+                (uint64_t)output, list->hb_fsr.have_inputs ? "ready" : "missing");
+    }
+    if (mode != HB_FSR_ON || !list->hb_fsr.have_inputs)
+        return false;
+    if (!output)
+        return pass == HB_FSR_PASS_ACCUMULATE; /* accumulate with sharpening: RCAS writes the output */
+
+    i32 = (const int32_t *)list->hb_fsr.cb;
+    f = (const float *)list->hb_fsr.cb;
+    hires_mv = hb_fsr_env_float("HB_FSR_MFX_HIRES_MV", 0.0f) != 0.0f;
+    target_w = (float)(hires_mv ? i32[4] : i32[0]);
+    target_h = (float)(hires_mv ? i32[5] : i32[1]);
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_METALFX_SCALE_INFO_MVK;
+    info.scalerId = 0x48424653; /* "HBFS" */
+    info.scalerType = VK_METALFX_SCALER_TYPE_TEMPORAL_MVK;
+    info.flags = VK_METALFX_SCALE_AUTO_EXPOSURE_BIT_MVK;
+    if (f[31] == 0.0f)
+        info.flags |= VK_METALFX_SCALE_RESET_BIT_MVK;
+    if (hb_fsr_env_float("HB_FSR_MFX_DEPTH_REVERSED", 1.0f) != 0.0f)
+        info.flags |= VK_METALFX_SCALE_DEPTH_REVERSED_BIT_MVK;
+    if (hires_mv)
+        info.flags |= VK_METALFX_SCALE_MOTION_DISPLAY_RES_BIT_MVK;
+    info.images[VK_METALFX_IMAGE_COLOR_MVK] = list->hb_fsr.color;
+    info.images[VK_METALFX_IMAGE_DEPTH_MVK] = list->hb_fsr.depth;
+    info.images[VK_METALFX_IMAGE_MOTION_MVK] = list->hb_fsr.motion;
+    info.images[VK_METALFX_IMAGE_OUTPUT_MVK] = output;
+    info.inputContentWidth = i32[0];
+    info.inputContentHeight = i32[1];
+    info.motionVectorScaleX = f[20] * target_w * hb_fsr_env_float("HB_FSR_MFX_MV_SIGN_X", 1.0f);
+    info.motionVectorScaleY = f[21] * target_h * hb_fsr_env_float("HB_FSR_MFX_MV_SIGN_Y", 1.0f);
+    info.jitterOffsetX = f[16] * hb_fsr_env_float("HB_FSR_MFX_JITTER_SIGN_X", 1.0f);
+    info.jitterOffsetY = f[17] * hb_fsr_env_float("HB_FSR_MFX_JITTER_SIGN_Y", 1.0f);
+    info.preExposure = 1.0f;
+    d3d12_command_list_metalfx_scale(list, &info, NULL, 0);
+    list->hb_fsr.have_inputs = false;
+    return true;
+}
+
 static void STDMETHODCALLTYPE d3d12_command_list_Dispatch(d3d12_command_list_iface *iface,
         UINT x, UINT y, UINT z)
 {
@@ -9401,7 +9583,10 @@ static void STDMETHODCALLTYPE d3d12_command_list_Dispatch(d3d12_command_list_ifa
     struct vkd3d_scratch_allocation scratch;
     const VkPhysicalDeviceLimits *limits;
 
-    TRACE("iface %p, x %u, y %u, z %u.\n", iface, x, y, z);
+    TRACE("iface %p, x %u, y %u, z %u.\\n", iface, x, y, z);
+
+    if (list->state && list->state->hb_fsr_pass && hb_fsr_dispatch(list))
+        return;
 
     d3d12_command_list_check_render_pass_validation(list, "Dispatch called within a render pass.\n", true);
     d3d12_command_list_flush_dgc_batch(list);
@@ -15040,6 +15225,8 @@ static void STDMETHODCALLTYPE d3d12_command_list_SetComputeRootConstantBufferVie
     TRACE("iface %p, root_parameter_index %u, address %#"PRIx64".\n",
             iface, root_parameter_index, address);
 
+    if (root_parameter_index < ARRAY_SIZE(list->hb_compute_root_cbv))
+        list->hb_compute_root_cbv[root_parameter_index] = address;
     d3d12_command_list_set_root_descriptor(list, &list->compute_bindings,
             root_parameter_index, address);
 }

From efbde45d3c46d0691c316fe965afef9bb8745963 Mon Sep 17 00:00:00 2001
From: hb-build <hb-build@local>
Date: Sun, 15 Nov 2026 04:17:24 +0500
Subject: [PATCH 07/27] highball 0009 + 0010 (0010 ported to master)

---
 libs/vkd3d/resource.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index fdb80053..abfa9989 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -4896,6 +4896,17 @@ HRESULT d3d12_resource_create_reserved(struct d3d12_device *device,
     struct d3d12_resource *object;
     HRESULT hr;
 
+    /* Some backends have no sparse binding at all. Use the same committed
+     * fallback as unsupported sparse image formats, including for buffers. */
+    if (!device->device_info.features2.features.sparseBinding)
+    {
+        FIXME("Sparse binding is unavailable, falling back to committed resource. "
+              "Dimension %u, width %"PRIu64", height %u, layers %u. VRAM bloat expected.\n",
+                desc->Dimension, desc->Width, desc->Height, desc->DepthOrArraySize);
+        return d3d12_resource_create_reserved_fallback(device, desc, initial_state,
+                optimized_clear_value, num_castable_formats, castable_formats, resource);
+    }
+
     if (desc->Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D)
     {
         format = vkd3d_get_format(device, desc->Format, !!(desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL));
@@ -5570,6 +5581,24 @@ static bool vkd3d_create_buffer_view_for_resource(struct d3d12_device *device,
     key.u.buffer.format = format;
     key.u.buffer.offset = resource->mem.offset + offset * element_size;
     key.u.buffer.size = size * element_size;
+
+    /* Highball: raw and structured shaders use the SSBO descriptor when available. The
+     * companion texel view exists for descriptor type aliasing; do not exceed
+     * the Vulkan limit while creating it. Keep the SSBO range and its byte
+     * bounds intact so raw/structured reads still reach the entire buffer. */
+    if (d3d12_device_use_ssbo_raw_buffer(device) &&
+            ((flags & VKD3D_VIEW_RAW_BUFFER) || (view_format == DXGI_FORMAT_UNKNOWN && structure_stride)))
+    {
+        VkDeviceSize max_size = (VkDeviceSize)device->device_info.properties2.properties.limits.maxTexelBufferElements
+                * format->byte_count;
+        if (key.u.buffer.size > max_size)
+        {
+            WARN("Limiting companion texel view from %llu to %llu bytes; keeping full SSBO range.\n",
+                    (unsigned long long)key.u.buffer.size, (unsigned long long)max_size);
+            key.u.buffer.size = max_size;
+        }
+    }
+
     if (flags & VKD3D_VIEW_BUFFER_SRV)
         key.u.buffer.usage = VK_BUFFER_USAGE_2_UNIFORM_TEXEL_BUFFER_BIT;
     else

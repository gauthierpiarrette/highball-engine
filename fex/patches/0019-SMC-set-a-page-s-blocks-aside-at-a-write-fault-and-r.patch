+
+    // SMC quarantine: an explicit invalidation frees the set-aside blocks of these pages, and every set-aside
+    // block that touches the range through any of its pages
+    const uint64_t RStart = Start & FEXCore::Utils::FEX_PAGE_MASK;
+    const uint64_t REnd = Start + Length;
+    for (auto& S : QSlots) {
+      if (!S.Page) {
+        continue;
+      }
+      bool Drop = S.Page >= RStart && S.Page < REnd;
+      for (const auto& B : S.Blocks) {
+        if (Drop) {
+          break;
+        }
+        for (auto cp : B.Entry.CodePages) {
+          if (cp >= RStart && cp < REnd) {

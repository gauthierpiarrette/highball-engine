+
+  // SMC quarantine. At an SMC write fault the blocks compiled from the page are set aside here instead of erased,
+  // with a copy of the page's bytes and a mask of the instruction bytes they were decoded from; when the page
+  // next gets code (CompileBlock), the masked bytes are compared and the blocks go back or are freed. The table
+  // is fixed and filled without allocating: the fault handler holds the thread-creation and code-invalidation
+  // mutexes, and allocating there deadlocked a game through Wine's FLS critical section. Blocks confined to the
+  // page are set aside; blocks spanning other pages are erased as before (a page copy vouches for one page).
+  struct QuarantinedBlock {
+    uint64_t Address;
+    BlockEntry Entry;
+  };
+  struct QSlot {
+    uint64_t Page {0};	// 0: free
+    fextl::vector<uint8_t> Bytes;	// FEX_PAGE_SIZE, allocated at construction
+    fextl::vector<uint8_t> Mask;	// FEX_PAGE_SIZE
+    fextl::vector<QuarantinedBlock> Blocks;	// capacity QUARANTINE_BLOCKS, never grown on the fault side
+  };
+  static constexpr size_t QUARANTINE_SLOTS = 8192;
+  static constexpr size_t QUARANTINE_BLOCKS = 192;
+  static constexpr size_t QUARANTINE_PROBES = 16;
+  fextl::vector<QSlot> QSlots;
+  uint64_t QuarantineEvictions {0};	// read by the fault side for the statistics
+  uint64_t QuarantineErased {0};
+
+  void InitQuarantine() {
+    QSlots.resize(QUARANTINE_SLOTS);
+    for (auto& S : QSlots) {
+      S.Bytes.resize(FEXCore::Utils::FEX_PAGE_SIZE);
+      S.Mask.resize(FEXCore::Utils::FEX_PAGE_SIZE);
+      S.Blocks.reserve(QUARANTINE_BLOCKS);
+    }
+  }
+
+  QSlot* FindQuarantine(uint64_t Page) {
+    if (QSlots.empty()) {
+      return nullptr;
+    }
+    size_t h = (Page >> 12) * 0x9E3779B97F4A7C15ull;
+    for (size_t i = 0; i < QUARANTINE_PROBES; i++) {
+      auto& S = QSlots[(h + i) % QUARANTINE_SLOTS];
+      if (S.Page == Page) {
+        return &S;
+      }
+    }
+    return nullptr;
+  }
+
+  QSlot* FreeQuarantineSlot(uint64_t Page) {
+    if (QSlots.empty()) {
+      return nullptr;
+    }
+    size_t h = (Page >> 12) * 0x9E3779B97F4A7C15ull;
+    for (size_t i = 0; i < QUARANTINE_PROBES; i++) {
+      auto& S = QSlots[(h + i) % QUARANTINE_SLOTS];
+      if (S.Page == 0) {
+        return &S;
+      }
+    }
+    // No free slot: evict the one at the first probe (its blocks were set aside for a page not run since; they
+    // are freed here as an erase would have freed them at the fault)
+    auto& S = QSlots[h % QUARANTINE_SLOTS];
+    S.Page = 0;
+    S.Blocks.clear();
+    QuarantineEvictions++;
+    return &S;
+  }
+
+  // The fault side (CodeInvalidationMutex held by the caller, as for InvalidateRange): blocks confined to Page
+  // are set aside, the others erased. Either way they leave BlockList and CodePages and their links in are cut.
+  void QuarantinePage(uint64_t Page) {
+    auto lk = AcquireWriteLock();
+    if (auto Old = FindQuarantine(Page)) {	// a record left from an earlier fault was never restored: start over
+      Old->Page = 0;
+      Old->Blocks.clear();
+    }
+    auto it = CodePages.find(Page >> 12);
+    if (it == CodePages.end()) {
+      return;
+    }
+    QSlot* S = FreeQuarantineSlot(Page);
+    bool Filled = false;
+    for (auto Address : it->second) {
+      auto bit = BlockList.find(Address);
+      if (bit == BlockList.end()) {
+        continue;
+      }
+      bool Confined = S && !bit->second.Ranges.empty() && S->Blocks.size() < QUARANTINE_BLOCKS;
+      if (Confined) {
+        for (auto cp : bit->second.CodePages) {
+          if ((cp >> 12) != (Page >> 12)) {
+            Confined = false;
+          }
+        }
+        for (const auto& R : bit->second.Ranges) {
+          if (R.first < Page || R.first + R.second > Page + FEXCore::Utils::FEX_PAGE_SIZE) {
+            Confined = false;
+          }
+        }
+      }
+      // Sever any links to this block
+      auto lower = BlockLinks->lower_bound({Address, nullptr});
+      auto upper = BlockLinks->upper_bound({Address, reinterpret_cast<FEXCore::Context::ExitFunctionLinkData*>(UINTPTR_MAX)});
+      for (auto l = lower; l != upper; l = BlockLinks->erase(l)) {
+        l->second(l->first.HostLink);
+      }
+      if (Confined) {
+        if (!Filled) {
+          memcpy(S->Bytes.data(), reinterpret_cast<const void*>(Page), FEXCore::Utils::FEX_PAGE_SIZE);
+          memset(S->Mask.data(), 0, FEXCore::Utils::FEX_PAGE_SIZE);
+          Filled = true;
+        }
+        for (const auto& R : bit->second.Ranges) {
+          for (uint64_t a = R.first; a < R.first + R.second; a++) {
+            S->Mask[a - Page] = 1;
+          }
+        }
+        S->Blocks.push_back({Address, std::move(bit->second)});
+      } else {
+        QuarantineErased++;
+      }
+      BlockList.erase(bit);
+    }
+    CodePages.erase(it);
+    if (Filled) {
+      S->Page = Page;
+    }
+  }
+
+  bool HasQuarantine(uint64_t Page, const LookupCacheReadLockToken&) {
+    return FindQuarantine(Page) != nullptr;
+  }
+
+  bool PageHasNoCode(uint64_t Page, const LookupCacheReadLockToken&) {
+    auto it = CodePages.find(Page >> 12);
+    return it == CodePages.end() || it->second.empty();
+  }
+
+  // The restore side, with the page protected again by the caller: unchanged instruction bytes put the blocks
+  // back and return GuestRIP's host code if it is one of them; changed bytes free them.
+  uintptr_t RestoreQuarantine(uint64_t Page, uint64_t GuestRIP, bool& Restored) {
+    auto lk = AcquireWriteLock();
+    Restored = false;
+    QSlot* S = FindQuarantine(Page);
+    if (!S) {
+      return 0;
+    }
+    const uint8_t* Now = reinterpret_cast<const uint8_t*>(Page);
+    bool Same = true;
+    for (size_t i = 0; i < FEXCore::Utils::FEX_PAGE_SIZE; i++) {
+      if (S->Mask[i] && Now[i] != S->Bytes[i]) {
+        Same = false;
+        break;
+      }
+    }
+    uintptr_t Host = 0;
+    if (Same) {
+      auto& CodePage = CodePages[Page >> 12];
+      for (auto& B : S->Blocks) {
+        if (B.Address == GuestRIP) {
+          Host = B.Entry.HostCode;
+        }
+        CodePage.push_back(B.Address);
+        BlockList.insert_or_assign(B.Address, std::move(B.Entry));
+      }
+      Restored = true;
+    }
+    S->Page = 0;
+    S->Blocks.clear();
+    return Host;
   }
 

+// SMC quarantine: the fault side, every code buffer's map (as InvalidateCodeBuffersCodeRange), with the counts
+void ContextImpl::SMCQuarantinePage(FEXCore::Core::InternalThreadState* Thread, uint64_t Page) {
+  LOGMAN_THROW_A_FMT(CodeInvalidationMutex.try_lock() == false, "CodeInvalidationMutex needs to be unique_locked here");
+  std::scoped_lock lk {CodeBufferListLock};
+  auto it = CodeBufferList.begin();
+  while (it != CodeBufferList.end()) {
+    if (auto Strong = it->lock()) {
+      auto& Map = *Strong->LookupCache;
+      const uint64_t Ev = Map.QuarantineEvictions, Er = Map.QuarantineErased;
+      uint64_t OnPage = 0;
+      {
+        auto rlk = Map.AcquireReadLock();
+        auto pit = Map.CodePages.find(Page >> 12);
+        if (pit != Map.CodePages.end()) {
+          OnPage = pit->second.size();
+        }
+      }
+      Map.QuarantinePage(Page);
+      if (Thread->ThreadStats) {
+        if (OnPage) {
+          std::atomic_ref<uint64_t>(Thread->ThreadStats->AccumulatedSMCBlocksOnPage).fetch_add(OnPage, std::memory_order_relaxed);
+        }
+        if (Map.QuarantineEvictions != Ev) {
+          std::atomic_ref<uint64_t>(Thread->ThreadStats->AccumulatedSMCEvictions).fetch_add(Map.QuarantineEvictions - Ev, std::memory_order_relaxed);
+        }
+        if (Map.QuarantineErased != Er) {
+          std::atomic_ref<uint64_t>(Thread->ThreadStats->AccumulatedSMCBlocksErased).fetch_add(Map.QuarantineErased - Er, std::memory_order_relaxed);
+        }
+      }
+      it++;
+    } else {
+      it = CodeBufferList.erase(it);
+    }
+  }
+}

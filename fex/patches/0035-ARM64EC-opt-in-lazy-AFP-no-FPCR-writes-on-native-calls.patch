diff --git a/FEXCore/include/FEXCore/Core/Context.h b/FEXCore/include/FEXCore/Core/Context.h
index c9757e13620a7ec610c30f97dd0079afffcd4501..a9215b60fa529d48aad533f5cdbafb664d349164 100644
--- a/FEXCore/include/FEXCore/Core/Context.h
+++ b/FEXCore/include/FEXCore/Core/Context.h
@@ -39,6 +39,11 @@ namespace FEXCore::Context {
 // HbJitWriteFn(false) (its own write-or-execute state); null means the pages are plain read-write-execute memory
 // that Wine flips between read-write and read-execute on every fault.
 FEX_DEFAULT_VISIBILITY extern void (*HbJitWriteFn)(bool Enable);
+// Highball HB_FEX_LAZY_AFP=1: the JIT sets FPCR.NEP but not FPCR.AH (no AH-dependent code: MIN/MAX and RPRES are
+// emulated), and leaving the JIT keeps NEP and FIZ (only armed trap enables are cleared, and only when one is armed),
+// so neither helper calls nor native calls write FPCR. Read when code is emitted; set by the frontend before the
+// first compile.
+FEX_DEFAULT_VISIBILITY extern bool HbLazyAFP;
 inline void HbJitWrite(bool Enable) {
   if (HbJitWriteFn) {
     HbJitWriteFn(Enable);
diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index 0cf6831fccf27037afe276d39fd682808793319d..fdd7243e6c530e2284a7be6e3294ab24b90ba947 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -56,10 +56,12 @@ BeginSimulation:
 .global ExitFunctionEC
 ExitFunctionEC:
   // Clear any the AFP NEP and AH bits in FPCR as native code won't expect their behaviour.
+  // The bits cleared come from HbExitFpcrClearMask: NEP + AH (6), the floating-point trap enables IOE DZE OFE UFE
+  // IXE (0x1f00, armed from MXCSR while in the JIT) and IDE (0x8000). HB_FEX_LAZY_AFP=1 leaves NEP set.
   mrs x17, fpcr
-  and x16, x17, #~6 // NEP + AH
-  and x16, x16, #~0x1f00 // floating-point trap enables IOE DZE OFE UFE IXE (armed from MXCSR while in the JIT)
-  and x16, x16, #~0x8000 // IDE
+  adrp x16, HbExitFpcrClearMask
+  ldr x16, [x16, :lo12:HbExitFpcrClearMask]
+  bic x16, x17, x16
   eor x17, x17, x16 // writing FPCR is slow on Apple cores, skip it when nothing changes
   cbz x17, 1f
   msr fpcr, x16
diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp

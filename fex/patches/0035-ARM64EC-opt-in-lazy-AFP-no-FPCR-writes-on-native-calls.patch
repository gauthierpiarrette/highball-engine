--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -79,6 +79,7 @@ extern uint64_t SyscallTable[];
 extern uint64_t SyscallTableEnd[];
 
 void* X64ReturnInstr; // See Module.S
+uint64_t HbExitFpcrClearMask = 0x9f06; // FPCR bits ExitFunctionEC clears, see Module.S
 uintptr_t NtDllBase;
 
 // Exports on ARM64EC point to x64 fast forward sequences to allow for redirecting to the JIT if functions are hotpatched. This LUT is from their addresses to the relative addresses of the native code exports.
@@ -908,6 +909,15 @@ NTSTATUS ProcessInit() {
   if (const char* Setting = std::getenv("HB_FEX_MAPJIT"); Setting && Setting[0] == '1') {
     FEXCore::Context::HbJitWriteFn = HbJitWriteToggle;
   }
+  // Highball HB_FEX_LAZY_AFP=1: the JIT uses FPCR.NEP but not FPCR.AH (x86 MIN/MAX and RCP/RSQRT are emulated as on
+  // hosts without AFP), and NEP stays set while native code and FEX's helpers run, so calls between x64 and ARM64EC
+  // code stop writing FPCR, which serializes the core on Apple chips. NEP only changes the upper lanes of scalar
+  // SIMD&FP results, which compiled code does not read: Wine's CRT math gave bit-identical results over 10,610 calls
+  // with it set (AH, set the same way, changed signs and results). Off unless set.
+  if (const char* Setting = std::getenv("HB_FEX_LAZY_AFP"); Setting && Setting[0] == '1') {
+    HbExitFpcrClearMask = 0x9f02; // AH (never set in this mode) and the trap enables; NEP stays
+    FEXCore::Context::HbLazyAFP = true;
+  }
   FEX::Windows::SetupThreadHandlers();
   const auto ExecutablePath = FEX::Windows::GetExecutableFilePath();
   AppConfigName = FEX::Windows::BaseName(ExecutablePath);

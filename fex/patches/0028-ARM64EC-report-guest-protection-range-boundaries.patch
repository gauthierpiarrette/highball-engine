+// Optional ntdll query hook: report guest protections and their next boundary.
+BOOL GuestProtectionRange(void* Address, ULONG* Prot, SIZE_T* Size) {
+  return !InvalidationTracker ||
+         InvalidationTracker->GuestProtectionRange(reinterpret_cast<uint64_t>(Address), *Prot, *Size);
+}

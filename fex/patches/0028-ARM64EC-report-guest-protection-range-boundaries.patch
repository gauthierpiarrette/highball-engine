+bool InvalidationTracker::GuestProtectionRange(uint64_t Address, ULONG& Prot, SIZE_T& Size) {
+  std::shared_lock Lock(IntervalsLock, std::try_to_lock);
+  if (!Lock.owns_lock()) {
+    return false;
+  }
+  if (SMCDetectionDisabled) {
+    return true;
+  }
+
+  const auto RWX = RWXIntervals.Query(Address);
+  const auto DEP = DEPPromotedIntervals.Query(Address);
+  if (RWX.Size) {
+    Size = std::min<uint64_t>(Size, RWX.Size);
+  }
+  if (DEP.Size) {
+    Size = std::min<uint64_t>(Size, DEP.Size);
+  }
+  constexpr ULONG Modifiers = PAGE_GUARD | PAGE_NOCACHE | PAGE_WRITECOMBINE;
+  if (RWX.Enclosed && (Prot & ~Modifiers) == GetTrapProt(Address)) {
+    Prot = GetUntrapProt(Address) | (Prot & Modifiers);
+  }
+  return true;
+}

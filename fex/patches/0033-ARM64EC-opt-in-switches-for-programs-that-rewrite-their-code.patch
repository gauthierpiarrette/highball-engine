+// Highball HB_FEX_SMC_INLINE: how many bytes an instruction that failed to decode is checked over when it starts a block on
+// an inline page: its legacy and REX prefixes, the opcode with its 0F, 0F 38 or 0F 3A escape, and one byte more (a
+// ModRM can make an opcode valid), kept within x86's 15 bytes and within the page (the next one may not be readable).
+uint64_t ContextImpl::HbInvalidInstLength(uint64_t Address) {
+  const uint64_t Available = std::min<uint64_t>(15, FEXCore::Utils::FEX_PAGE_SIZE - (Address & (FEXCore::Utils::FEX_PAGE_SIZE - 1)));
+  const auto* Bytes = reinterpret_cast<const uint8_t*>(Address);
+  uint64_t Length = 0;
+  while (Length < Available) {
+    const uint8_t Byte = Bytes[Length];
+    const bool Prefix = Byte == 0x66 || Byte == 0x67 || Byte == 0xF0 || Byte == 0xF2 || Byte == 0xF3 || Byte == 0x2E || Byte == 0x36 ||
+                        Byte == 0x3E || Byte == 0x26 || Byte == 0x64 || Byte == 0x65 || (Config.Is64BitMode && (Byte & 0xF0) == 0x40);
+    if (!Prefix) {
+      break;
+    }
+    Length++;
+  }
+  if (Length < Available) {
+    const uint8_t Opcode = Bytes[Length++];
+    if (Opcode == 0x0F && Length < Available) {
+      const uint8_t Escape = Bytes[Length++];
+      if ((Escape == 0x38 || Escape == 0x3A) && Length < Available) {
+        Length++;
+      }
+    }
+  }
+  return std::min(Available, Length + 1);
+}
